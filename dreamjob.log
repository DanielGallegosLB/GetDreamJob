out(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_KA6eadnTDPbd1sQPmfyNiAY_166';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"3uhdG8q0sub7p9QhAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador full stack semi senior\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;KA6eadnTDPbd1sQPmfyNiAY85 xQKg9c;_;KA6eadnTDPbd1sQPmfyNiAY88\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Desarrollador full stack\u003Cbr>\u003Cbr>¿Te apasiona el desarrollo de productos? Nuestro cliente, líder en tecnología, busca un Desarrollador Full Stack Back End para diseñar la plataforma que conecta detección, respuesta y trazabilidad en la gestión de incidentes.\u003Cbr>\u003Cbr>Funciones y responsabilidades\u003Cbr>• Desarrollar APIs seguras para gestionar incidentes, evidencias, acciones, aprobaciones y auditorías.\u003Cbr>• Configurar a\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_200\" aria-live=\"polite\" style=\"display:none\">utenticación y autorización (OIDC, RBAC/ABAC), asegurando separación de funciones.\u003Cbr>• Definir el flujo completo de estados de un incidente: desde la detección hasta el cierre.\u003Cbr>• Garantizar trazabilidad y auditoría mediante registros seguros y únicos (append-only, request IDs, idempotency).\u003Cbr>• Construir una interfaz básica en React para visualizar incidentes, aprobaciones, evidencias y estados.\u003Cbr>• Aplicar límites operativos como control de uso (rate limits, cuotas) y preparación para entornos multiusuario.\u003Cbr>• Integrar eventos del sistema y asegurar contratos estables para otros componentes y motores de acción.\u003Cbr>• Desarrollo sobre servicios AWS\u003Cbr>\u003Cbr>Condiciones del cargo\u003Cbr>• Ubicación: Santiago, Chile\u003Cbr>• Modalidad: Presencial\u003Cbr>• Idioma: Español + Inglés técnico\u003Cbr>• Renta: Competitiva acorde al mercado\u003Cbr>\u003Cbr>Requisitos excluyentes\u003Cbr>• 2+ años desarrollando APIs seguras en entornos productivos.\u003Cbr>• Experiencia implementando OIDC/OAuth2 y control de acceso RBAC/ABAC.\u003Cbr>• Conocimiento en auditoría y trazabilidad (logs estructurados, append-only).\u003Cbr>• Capacidad para construir interfaces funcionales en React u otro framework similar.\u003Cbr>• Experiencia con idempotencia y sistemas event-driven o colas.\u003Cbr>• Stack principal: Tool-calling, RAG, eval harness, CI/CD, APIs, Backend (Go/Java/Kotlin/TS), OIDC, RBAC/ABAC, Postgres, Event bus, React, AWS.\u003Cbr>\u003Cbr>Requisitos deseables\u003Cbr>• Patrones multi-tenant SaaS, event sourcing y gestión de cambios.\u003Cbr>• Seguridad de aplicaciones (OWASP), threat modeling básico, firmas/hashes en evidencia.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_200\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB0QMQ\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQl5ACegQIHRAx\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQ5ZkFegQIHRAy\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQyo8CegQIHRAz\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'SSI Outsourcing',job_title:'Desarrollador full stack semi senior'})&quot;,&quot;_KA6eadnTDPbd1sQPmfyNiAY_211&quot;,null,13,null,null,null,null,null,5025273,&quot;horizon_jobs&quot;,[null,null,null,null,null,null,null,[[&quot;share_link&quot;,&quot;https://www.google.com/search?q\\u003dDesarrollador+Junior+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19&quot;],[&quot;jobs_posting_urls_1&quot;,&quot;https://cl.linkedin.com/jobs/view/desarrollador-full-stack-semi-senior-at-ssi-outsourcing-4374819045?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic&quot;],[&quot;jobs_posting_domain_1&quot;,&quot;&quot;],[&quot;jobs_posting_urls&quot;,&quot;\\nhttps://cl.linkedin.com/jobs/view/desarrollador-full-stack-semi-senior-at-ssi-outsourcing-4374819045?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic&quot;],[&quot;jobs_encoded_docids&quot;,&quot;\\n3uhdG8q0sub7p9QhAAAAAA\\u003d\\u003d&quot;]]],null,null,null,null,null,30,null,null,null,1,null,1]\" data-ofbl=\"114,120,134\" data-pid=\"5025273\" jsdata=\"vST7rb;_;KA6eadnTDPbd1sQPmfyNiAY109 zEIyGd;_;\" jsaction=\"kPzEO:MlP2je;qjLxRc:FbhRG;w8f1fc:hRwSgb;kq2wxf:s5CUif;aIJAdf:UhDUnd;rwuG3b:KGQHJd;BqbTbe:naa5ve;kYAKrf:CqUGrf;hwhRRe:KyxjCd;rcuQ6b:npT2md\">\u003Cdiv id=\"_KA6eadnTDPbd1sQPmfyNiAY_213\">\u003Cdiv jsname=\"GkjeIf\" id=\"_KA6eadnTDPbd1sQPmfyNiAY_215\" data-jiis=\"up\" data-async-type=\"kp_feedback\" c