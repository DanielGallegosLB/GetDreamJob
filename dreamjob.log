003Cscript nonce=\"z28v0oPg8LRKL0vlIkfkyA\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_KA6eadnTDPbd1sQPmfyNiAY_141';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"ZHdEftk79x7RhMu_AAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Junior full stack con experiencia en typescrip(remoto)\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;KA6eadnTDPbd1sQPmfyNiAY50 xQKg9c;_;KA6eadnTDPbd1sQPmfyNiAY53\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Tienes al menos 1 año de experiencia desarrollando soluciones web y quieres seguir creciendo en un entorno técnico exigente? Buscamos un/a Desarrollador/a Full Stack Junior o Semi-Senior con ganas de aprender, aportar y trabajar en proyectos reales con tecnologías modernas.\u003Cbr>\u003Cbr>️️ Requisitos deseables:\u003Cbr>+1 año de experiencia en desarrollo frontend y/o backend.\u003Cbr>\u003Cbr>Conocimientos en NestJS, Laravel (PHP), \u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_162\" aria-live=\"polite\" style=\"display:none\">Next.js o Nuxt.js.\u003Cbr>\u003Cbr>Familiaridad con Docker y conceptos de dockerización.\u003Cbr>\u003Cbr>Experiencia básica en servidores Linux y despliegues en VMs.\u003Cbr>\u003Cbr>Manejo de bases de datos relacionales: MySQL y/o PostgreSQL.\u003Cbr>\u003Cbr>Creación y consumo de APIs RESTful, pruebas con Postman.\u003Cbr>\u003Cbr>Conocimientos en automatización con Bash scripts (nivel básico/intermedio).\u003Cbr>\u003Cbr>Experiencia realizando CRUDs y siguiendo buenas prácticas de desarrollo.\u003Cbr>\u003Cbr>Uso de Git y trabajo en equipos con repositorios en GitHub o Bitbucket.\u003Cbr>\u003Cbr>Conocimiento o participación en flujos de CI/CD y herramientas como Bitbucket Pipelines.\u003Cbr>\u003Cbr>Interés por aprender sobre microservicios, arquitectura escalable y SonarQube.\u003Cbr>\u003Cbr>Familiaridad con metodologías ágiles como Scrum o Kanban.\u003Cbr>\u003Cbr>Valoramos:\u003Cbr>\u003Cbr>Ganas de aprender y crecer técnicamente.\u003Cbr>\u003Cbr>Iniciativa y buena comunicación.\u003Cbr>\u003Cbr>Enfoque en la calidad del código y el trabajo en equipo.\u003Cbr>\u003Cbr>¿Estás listo para el siguiente paso en tu carrera? ¡Postula o comparte esta oportunidad con alguien que esté buscando crecer como desarrollador/a!\u003Cbr>\u003Cbr>Renta Entre 900.000 a 1.200.000 liquido según experiencia\u003Cbr>Interesados enviar currículum actualizado con pretensiones de renta.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_162\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCIQN