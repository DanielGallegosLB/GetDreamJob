?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_9PeeafO7I9zc1sQPvMbE8Qs_159';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"i8ZKLEqFez0vgeC6AAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Consultor Programador TI (Desarrollador Backend) Perfil JR - Remoto\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;9PeeafO7I9zc1sQPvMbE8Qs62 xQKg9c;_;9PeeafO7I9zc1sQPvMbE8Qs64\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">¡Somos Atcom!\u003Cbr>\u003Cbr>Importante empresa se encuentra en búsqueda de un Consultor y Programador TI (Desarrollador Backend) con perfil Junior para prestigiosa empresa internacional.\u003Cbr>\u003Cbr>¿Qué perfil debes tener para postular?\u003Cbr>Requisitos Obligatorios:\u003Cbr>- Formación académica, Ingeniería en informática.\u003Cbr>- 1 a 2 años de experiencia laboral en desarrollo de software backend\u003Cbr>- Conocimientos funcionales de PHP, Javas\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_9PeeafO7I9zc1sQPvMbE8Qs_168\" aria-live=\"polite\" style=\"display:none\">cript y base de datos como MySQL o PostgreSQL\u003Cbr>- Comprensión básica de APIs REST y estructuras JSON\u003Cbr>- Nivel intermedio de Excel y herramientas de oficina.\u003Cbr>- Ingles Técnico básico (Lectura de documentación).\u003Cbr>\u003Cbr>Requisitos Ideales:\u003Cbr>- Ingles Intermedio B1\u003Cbr>- Experiencia en nube pública (AWS o GCP)\u003Cbr>- Conocimientos básicos de servicios como Lambdas, App Engine, Cloud Run, etc.\u003Cbr>- Familiaridad con procesos de integración y herramientas como postman o swagger\u003Cbr>- Conocimiento básico en plataformas como Cornerstone OnDemand, Kore.ai u otras herramientas corportativas\u003Cbr>\u003Cbr>¿Qué funciones desempeñarás en este cargo?\u003Cbr>1. Apoyar en el desarrollo y mantención de sistemas backend existentes.\u003Cbr>2. Participar en tareas de integración con APIs internas y externas.\u003Cbr>3. Colaborar en la documentación técnica básica de los desarrollos realizados.\u003Cbr>4. Realizar pruebas funcionales simples y apoyar en la revisión de código.\u003Cbr>5. Mantener comunicación fluida con otros desarrolladores y áreas de soporte.\u003Cbr>6. Levantar incidencias técnicas y dar seguimiento a correcciones o mejoras.\u003Cbr>\u003Cbr>¿Qué te ofrecemos?\u003Cbr>Renta líquida acorde al mercado.\u003Cbr>Horario: lunes a jueves de 9:00 a 19:00 horas, viernes de 9:00 a 18:00 horas.\u003Cbr>Modalidad: 100% remota.\u003Cbr>Tipo de contrato: Plazo fijo inicialmente por servicios transitorios, según desempeño, alta probabilidad de internalización.-Requerimientos- Educación mínima: Universitaria / I.P. / C.F.T.\u003Cbr>1 año de experiencia\u003Cbr>Edad: A partir de 25 años\u003Cbr>Palabras clave: consultant, consultor, developer, desarrollador, programador, junior, casa, remoto, remote, teletrabajo, home\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_9PeeafO7I9zc1sQPvMbE8Qs_168\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CBwQMQ\" data-ved=\"2ahUKEwjzhf_X3vSSAxVcr