ww.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"pW5NM4a40KcmcCkt53lrkQ\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_dveeaaRth9_WxA_gqJSBAg_157';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"7AY0z8XCOrrs0knDAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Backend / Web (Spring Boot)\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;dveeaaRth9_WxA_gqJSBAg59 xQKg9c;_;dveeaaRth9_WxA_gqJSBAg60\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Buscamos un/a Desarrollador/a Backend / Web con al menos 3 años de experiencia en desarrollo y mantenimiento de aplicaciones web, con foco en Spring Boot.\u003Cbr>La persona seleccionada será responsable de diseñar, desarrollar y mantener soluciones web robustas, seguras y escalables, participando activamente en todo el ciclo de vida del desarrollo de software: levantamiento de requerimientos, desarrollo,\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_dveeaaRth9_WxA_gqJSBAg_167\" aria-live=\"polite\" style=\"display:none\">&nbsp;pruebas, despliegue y soporte.\u003Cbr>Además, trabajará con entornos Linux y bases de datos relacionales, colaborando con equipos técnicos y funcionales para asegurar la calidad y continuidad de las aplicaciones.\u003Cbr>Funciones principales\u003Cbr>Diseñar, desarrollar y mantener aplicaciones web backend utilizando Java + Spring Boot.\u003Cbr>Implementar y consumir APIs REST.\u003Cbr>Participar en el análisis técnico y diseño de soluciones.\u003Cbr>Gestionar y optimizar consultas en bases de datos relacionales.\u003Cbr>Realizar mantenimiento correctivo y evolutivo de aplicaciones existentes.\u003Cbr>Ejecutar pruebas unitarias e integración para asegurar la calidad del software.\u003Cbr>Apoyar procesos de despliegue y monitoreo en ambientes Linux.\u003Cbr>Documentar desarrollos, incidencias y mejoras implementadas.-Requerimientos- Educación mínima: Universitaria / I.P. / C.F.T.\u003Cbr>años de experiencia\u003Cbr>Palabras clave: developer, programador, internet, web\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_dveeaaRth9_WxA_gqJSBAg_167\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCAQMw\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQl5ACegQIIBAz\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003