\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e💼 Condiciones\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e• Proyecto por 6 meses\\u003c/p\\u003e\\u003cp\\u003e• Modalidad 100% remota\\u003c/p\\u003e\\u003cp\\u003e• Lunes a viernes 09:00 – 18:30\\u003c/p\\u003e\\u003cp\\u003e• Debes residir en Chile\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003eSi te motiva trabajar con arquitectura moderna, seguridad aplicada y desafíos regulatorios reales, este proyecto es para ti.\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e📩 Escríbeme por interno o postula directamente. \\u003c/p\\u003e\\u003cp\\u003eMarcia.rodriguez@kibernum.com\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e#Fullstack #Java #SpringBoot #React #AWS #Microservicios #TechJobs #Chile\\u003c/p\\u003e\",\"Desarrollador/a Fullstack\",null,null,0,[[\"organization\",\"Kibernum\"],[\"publisher_name\",\"LinkedIn\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0xf194e46ff5746736\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"dveeaaRth9_WxA_gqJSBAg64\":[null,null,null,null,null,null,null,null,[[15113300,0.2859406,4]]],\"dveeaaRth9_WxA_gqJSBAg84\":[\"https://cl.linkedin.com/jobs/view/desarrollador-a-fullstack-at-kibernum-4374596673?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"LinkedIn\",\"ZF7P3hMJii4SYXOyAAAAAA\\u003d\\u003d\",0,1],\"dveeaaRth9_WxA_gqJSBAg86\":[\"https://cl.bebee.com/job/eba873d64dec5b9516a30ad995857fd4?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",\"bebee.com\",\"BeBee CL\",\"wm51FqsuURoAAA