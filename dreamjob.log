r\\u003e Conocimiento en arquitecturas distribuidas y orientadas a eventos \\u003cbr\\u003e\\u003cbr\\u003e Experiencia en nube y herramientas de CI/CD \\u003cbr\\u003e\\u003cbr\\u003e Manejo de Git y flujos de versionamiento \\u003cbr\\u003e\\u003cbr\\u003e Buenas prácticas en desarrollo seguro y pruebas automatizadas\",\"Ingeniero desarrollador Backend\",null,null,0,[[\"organization\",\"Maclean Ltda\"],[\"publisher_name\",\"Indeed Chile\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0x25027319f46e62fa\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"dveeaaRth9_WxA_gqJSBAg78\":[null,null,null,null,null,null,null,null,[[15113300,0.23478498,4]]],\"dveeaaRth9_WxA_gqJSBAg89\":[\"https://cl.indeed.com/viewjob?jk\\u003d456c714cf58bf721\\u0026utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"Indeed Chile\",\"jYzLsKsX-iTkfc3cAAAAAA\\u003d\\u003d\",1,1],\"dveeaaRth9_WxA_gqJSBAg93\":[\"https://cl.jooble.org/rjdp/-5639384282163419953?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",\"jooble.org\",\"Jooble\",\"PsARxQCzYlIAAAAAAAAAAA\",0],\"dveeaaRth9_WxA_gqJSBAg101\":[\"https://cl.linkedin.com/jobs/view/desarrollador-backend-python-at-avos-tech-chile-4196399571?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",\"linkedin.com\",\"LinkedIn\",\"nTY6fk5iuB4AAAAAAAAAAA\",0],\"dveeaaRth9_WxA_gqJSBAg102\":[\"https://cl.bebee.com/job/ef7d5173546796885a707912c2848acd?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",\"bebee.com\",\"BeBee\",\"nje-IZCtgHoAAAAAAAAAAA\",0],\"dveeaaRth9