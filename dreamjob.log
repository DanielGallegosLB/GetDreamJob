d=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyJoRegQIJBA1\">\u003Cg-right-button jsname=\"IHFM4\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"sYPGdb\" class=\"wgbRNb VdehBf tHT0l OZ5bRd btpNFe\" tabindex=\"-1\" aria-label=\"Siguiente\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"lAavCfiX0OcZaL1aqtFOVg\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_h3Kfae6MB7DA5OUP5dDBkA4_150';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"R_h9BwsRUqayGGGsAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"QA Engineer\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;h3Kfae6MB7DA5OUP5dDBkA452 xQKg9c;_;h3Kfae6MB7DA5OUP5dDBkA454\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Buscamos un/a QA Senior / QA Engineer con sólida experiencia en pruebas End to End (E2E), entornos cloud y monitoreo de aplicaciones, para integrarse a un proyecto inicial en un entorno tecnológico desafiante. El rol es 100% técnico, enfocado en asegurar la calidad de aplicaciones y servicios durante todo el ciclo de desarrollo.\u003Cbr>\u003Cbr>Requisitos Excluyentes\u003Cbr>\u003Cbr>Experiencia mayor a 3 años en roles de QA.\u003Cbr>\u003Cbr>\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_225\" aria-live=\"polite\" style=\"display:none\">Experiencia en pruebas End to End (E2E).\u003Cbr>\u003Cbr>Experiencia en aplicaciones web, móviles y/o web services.\u003Cbr>\u003Cbr>Conocimiento y experiencia en entornos cloud (nubes).\u003Cbr>\u003Cbr>Experiencia en monitoreo de métricas con Grafana y/o Kibana.\u003Cbr>\u003Cbr>Experiencia trabajando bajo metodologías ágiles (Scrum, Kanban).\u003Cbr>\u003Cbr>Responsabilidades\u003Cbr>\u003Cbr>Ejecución de pruebas funcionales.\u003Cbr>\u003Cbr>Ejecución de pruebas no funcionales (usabilidad, compatibilidad, seguridad).\u003Cbr>\u003Cbr>Diseño y ejecución de casos de prueba.\u003Cbr>\u003Cbr>Diseño y mantención de planes de prueba.\u003Cbr>\u003Cbr>Ejecución de pruebas en distintos niveles: unitarias, integración, regresión y E2E.\u003Cbr>\u003Cbr>Análisis del impacto de cambios en los sistemas.\u003Cbr>\u003Cbr>Análisis de resultados mediante logs, servicios y data de prueba.\u003Cbr>\u003Cbr>Documentación técnica asociada a servicios, backend y arquitectura.\u003Cbr>\u003Cbr>Gestión y seguimiento de incidencias y mejoras en herramientas como Jira, TestLink u otras.\u003Cbr>\u003Cbr>Ejecución y análisis de procesos automatizados de testing.\u003Cbr>\u003Cbr>Participación en pipelines CI/CD (Jenkins u otros).\u003Cbr>\u003Cbr>Herramientas y Tecnologías\u003Cbr>\u003Cbr>Testing: SoapUI, Postman, Zephyr, entre otras.\u003Cbr>\u003Cbr>Gestión: Jira, TestLink o similares.\u003Cbr>\u003Cbr>CI/CD: Jenkins, Pipelines.\u003Cbr>\u003Cbr>Monitoreo: Grafana, Kibana.\u003Cbr>\u003Cbr>Metodologías ágiles.\u003Cbr>\u003Cbr>Perfil Buscado\u003Cbr>\u003Cbr>Perfil técnico, analítico y orientado a la calidad.\u003Cbr>\u003Cbr>Capacidad de trabajo autónomo.\u003Cbr>\u003Cbr>Visión E2E de los sistemas.\u003Cbr>\u003Cbr>Enfoque en mejora continua y buenas prácticas de testing.\u003Cbr>\u003Cbr>Postulación:\u003Cbr>Enviar CV actualizado a [email] indicando en el asunto QA Senior E2E.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_225\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCQQOA\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQl5ACegQIJBA4\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQ5ZkFegQIJBA5\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyo8CegQIJBA6\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon