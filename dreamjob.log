HT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_N83naZjbOsbc5OUPqtL4kAM_193';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"onMvszaKTYi0AZZeAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Odoo\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;N83naZjbOsbc5OUPqtL4kAM68 xQKg9c;_;N83naZjbOsbc5OUPqtL4kAM70\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">En Kibernum estamos buscando un Desarrollador Odoo para un importante cliente del rubro de alimentos. Si tienes experiencia con Odoo y te apasiona la tecnología, ¡te estamos esperando! 🔍\u003Cbr>\u003Cbr>🔍 Ubicación: Santiago, Chile (Modalidad Híbrida: 3 días presenciales, 2 días remoto)\u003Cbr>\u003Cbr>⏳ Tipo de Contrato: Proyecto de 4 meses.\u003Cbr>\u003Cbr>¿Quiénes somos?\u003Cbr>\u003Cbr>En Kibernum estamos trabajando con un importante cliente del rubr\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_204\" aria-live=\"polite\" style=\"display:none\">o de alimentos y buscamos un Desarrollador Odoo que quiera unirse a nuestro equipo para personalizar y optimizar la plataforma Odoo en un proyecto desafiante. 😎\u003Cbr>\u003Cbr>¿Te apasiona Odoo? Si tienes experiencia en personalizaciones y optimizaciones, ¡te estamos buscando! 💻✨\u003Cbr>\u003Cbr>Responsabilidades:\u003Cbr>\u003Cbr>Crear y personalizar módulos de Odoo.\u003Cbr>\u003Cbr>Integrar Odoo con otros sistemas mediante APIs.\u003Cbr>\u003Cbr>Optimizar procesos internos y asegurar su alineación con los objetivos del cliente.\u003Cbr>\u003Cbr>Trabajar con Python, PostgreSQL, y mucho más.\u003Cbr>\u003Cbr>Asegurar el buen funcionamiento de la plataforma a través de soporte y mantenimiento continuo.\u003Cbr>\u003Cbr>Colaborar con un equipo ágil en Scrum y con líderes técnicos.\u003Cbr>\u003Cbr>Requisitos:\u003Cbr>\u003Cbr>+3 años de experiencia en desarrollo Odoo.\u003Cbr>\u003Cbr>Conocimientos avanzados en Python y experiencia en PostgreSQL.\u003Cbr>\u003Cbr>Capacidad para trabajar con APIs y otros sistemas externos.\u003Cbr>\u003Cbr>Deseable: Conocimiento básico de Angular y Java.\u003Cbr>\u003Cbr>Buenas habilidades comunicacionales y de trabajo en equipo.\u003Cbr>\u003Cbr>Si eres un apasionado de Odoo y quieres enfrentar un nuevo reto, este proyecto es para ti. ¡Postula ya! 😄💥\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_204\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCQQSQ\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQl5ACegQIJBBJ\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQ5ZkFegQIJBBK\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQyo8CegQIJBBL\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jsl