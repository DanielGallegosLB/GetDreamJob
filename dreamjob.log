\\u003cli\\u003eParticipación activa en células de producto (enfoque MVP)\\u003c/li\\u003e \\u003cli\\u003eAsegurar calidad y seguridad (testing, OWASP, automatización)\\u003c/li\\u003e \\u003cli\\u003eMentoría técnica y gestión de deuda tecnológica\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e🔹 \\u003cstrong\\u003eHabilidades y actitud:\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e \\u003cli\\u003eMindset autodidacta y proactivo\\u003c/li\\u003e \\u003cli\\u003eFuerte orientación al trabajo colaborativo\\u003c/li\\u003e \\u003cli\\u003eInterés en el crecimiento continuo del equipo\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e🔹 \\u003cstrong\\u003eStack tecnológico requerido:\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e \\u003cli\\u003eArquitectura: Microservicios y Event-Driven\\u003c/li\\u003e \\u003cli\\u003eBackend: Node.js (JavaScript/TypeScript) y PHP (Laravel)\\u003c/li\\u003e \\u003cli\\u003eFrontend \\u0026 Mobile: Angular, Vue y React Native\\u003c/li\\u003e \\u003cli\\u003eBases de datos: PostgreSQL y Firestore\\u003c/li\\u003e \\u003cli\\u003eInfraestructura: Linux, Kubernetes (K8s) y CI/CD con GitLab\\u003c/li\\u003e \\u003cli\\u003eMensajería: Kafka, RabbitMQ o Pub/Sub\\u003c/li\\u003e \\u003cli\\u003eCloud \\u0026 observabilidad: GCP o AWS\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e💰 \\u003cstrong\\u003eRenta líquida:\\u003c/strong\\u003e $3.000.000\\u003c/p\\u003e\\u003cp\\u003e📄 \\u003cstrong\\u003eCondiciones:\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e \\u003cli\\u003eContrato a plazo fijo (3 y 6 meses), luego indefinido\\u003c/li\\u003e \\u003cli\\u003eModalidad 100% presencial\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e🕒 \\u003cstrong\\u003eHorario:\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e \\u003cli\\u003eLunes a jueves: 08:30 a 18:30 hrs\\u003c/li\\u003e \\u003cli\\u003eViernes: 08:30 a 16:15 hrs\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e🎁 \\u003cstrong\\u003eBeneficios:\\u003c/strong\\u