nit](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"osu19Mgjtcksi5QRAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Programador/a C# y Python - Ingeniero o Técnico en informatica\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;N83naZjbOsbc5OUPqtL4kAM66 xQKg9c;_;N83naZjbOsbc5OUPqtL4kAM69\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">🚀 PROGRAMADOR/A C# y Python📍 Área Planning – Proyecto Minería\u003Cbr>\u003Cbr>¿Te interesa desarrollar soluciones tecnológicas aplicadas a la minería? ¡Esta oportunidad es para ti!\u003Cbr>\u003Cbr>Buscamos Programador/a para integrarse al área de Planning, participando en el desarrollo de soluciones innovadoras para clientes mineros.\u003Cbr>\u003Cbr>🎯 Objetivo del cargo\u003Cbr>• Desarrollo y mantenimiento de scripts y aplicaciones en C# y Python\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_208\" aria-live=\"polite\" style=\"display:none\">\u003Cbr>• Proponer automatización de procesos de integración con otras bases de datos\u003Cbr>• Interactuar con ingenieros de minas y geólogos para validar resultados y explorar nuevos desarrollos\u003Cbr>🔎 Funciones específicas\u003Cbr>• Entrega de resultados a clientes mineros\u003Cbr>• Elaboración de documentación técnica\u003Cbr>• Generación de reportes QA/QC como respaldo técnico en cada entrega\u003Cbr>🎓 Requisitos\u003Cbr>• Título: Ingeniero/a o Técnico/a en Informática\u003Cbr>• Lenguajes: C# y Python (no excluyente, pero deseable)\u003Cbr>• Idioma: Inglés funcional para comunicación con áreas de desarrollo\u003Cbr>📍 Ubicación\u003Cbr>• Las Condes\u003Cbr>🕘 Jornada laboral\u003Cbr>• Lunes a viernes 09:00 a