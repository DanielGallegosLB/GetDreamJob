\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_Xt3nabi2AfPS1sQPntOBkQQ_232';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"nG4Wry5WcempE1YWAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Analista Desarrollador / Analista Programador\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;Xt3nabi2AfPS1sQPntOBkQQ77 xQKg9c;_;Xt3nabi2AfPS1sQPntOBkQQ79\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Company Description: Tinsa Chile S.A.\u003Cbr>\u003Cbr>Job Description: Empresa multinacional del rubro de servicios, con fuerte foco en soluciones tecnológicas orientadas a la gestión y optimización de procesos críticos del negocio , busca incorporar a su equipo de Informática un/a Analista Desarrollador.\u003Cbr>\u003Cbr>La compañía desarrolla y mantiene plataformas propias que apoyan la operación de sus clientes en distintos \u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_Xt3nabi2AfPS1sQPntOBkQQ_268\" aria-live=\"polite\" style=\"display:none\">mercados , combinando experiencia operativa, conocimiento del negocio y desarrollo interno de software. El rol estará orientado al diseño y evolución de soluciones tecnológicas de alto impacto , contribuyendo directamente a la eficiencia, escalabilidad y mejora continua de la organización.\u003Cbr>\u003Cbr>Objetivo del Cargo\u003Cbr>\u003Cbr>Diseñar, desarrollar y mantener soluciones de software eficientes, seguras y escalables , asegurando altos estándares de calidad y contribuyendo a la optimización de procesos y a la mejora continua de las operaciones de la compañía.\u003Cbr>\u003Cbr>️ Principales Responsabilidades\u003Cbr>\u003Cbr>Desarrollar aplicaciones y sistemas de software de acuerdo con los requerimientos\u003Cbr>\u003Cbr>funcionales y técnicos definidos.\u003Cbr>\u003Cbr>Analizar, levantar y documentar requerimientos de usuarios y áreas internas.\u003Cbr>\u003Cbr>Participar en todas las etapas del ciclo de desarrollo: análisis, diseño, desarrollo, pruebas,\u003Cbr>\u003Cbr>implementación y mantenimiento.\u003Cbr>\u003Cbr>Ejecutar pruebas unitarias, de integración y de aceptación para asegurar la calidad y\u003Cbr>\u003Cbr>estabilidad de las soluciones.\u003Cbr>\u003Cbr>Mantener y mejorar sistemas existentes, brindando soporte técnico cuando sea requerido.\u003Cbr>\u003Cbr>Elaborar y mantener documentación técnica clara y actualizada.\u003Cbr>\u003Cbr>Colaborar activamente con equipos multidisciplinarios.\u003Cbr>\u003Cbr>Diagnosticar y resolver incidencias técnicas de manera oportuna y eficiente.\u003Cbr>\u003Cbr>Perfil del Cargo\u003Cbr>\u003Cbr>Título profesional en Informática, Ingeniería en Computación o carrera afín.\u003Cbr>\u003Cbr>Experiencia en desarrollo de aplicaciones web dinámicas.\u003Cbr>\u003Cbr>Experiencia en todas las fases del desarrollo de software.\u003Cbr>\u003Cbr>Alta capacidad de adaptación al cambio.\u003Cbr>\u003Cbr>️ Buenas habilidades de comunicación y trabajo colaborativo.\u003Cbr>\u003Cbr>Orientación a la responsabilidad, proactividad y actitud positiva.\u003Cbr>\u003Cbr>Capacidad para trabajar en equipo.\u003Cbr>\u003Cbr>Requisitos Técnicos (Excluyentes)\u003Cbr>\u003Cbr>️ Conocimientos avanzados en modelado de bases de datos relacionales.\u003Cbr>\u003Cbr>Experiencia sólida en MySQL.\u003Cbr>\u003Cbr>Dominio avanzado de PHP.\u003Cbr>\u003Cbr>Experiencia en REST, JSON, AJAX y consumo de API/Services.\u003Cbr>\u003Cbr>Conocimientos en JavaScript y/o TypeScript.\u003Cbr>\u003Cbr>Experiencia en desarrollo Front-End y Back-End.\u003Cbr>\u003Cbr>Conocimientos Deseables\u003Cbr>\u003Cbr>Bootstrap y jQuery.\u003Cbr>\u003Cbr>Framework Scriptcase.\u003Cbr>\u003Cbr>Desarrollo con Ionic y Angular.\u003Cbr>\u003Cbr>Experiencia en despliegues en AWS, incluyendo integración continua y operación en\u003Cbr>\u003Cbr>ambientes productivos.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_Xt3nabi2AfPS1sQPntOBkQQ_268\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCIQUw\" data-ved=\"2ahUKEwi43a_M4_-TAxVzqZUCHZ5pIEIQl5ACegQIIhBT\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwi43a_M4_-TAxVzqZUCHZ5pIEIQ5ZkFegQIIhBU\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwi43a_M4_-TAxVzqZUCHZ5pIEIQyo8CegQIIhBV\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Tinsa Chile by Accumin',job_title:'Analista Desarrollador / Analista Programador'})&quot;,&quot;_Xt3nabi2AfPS1sQPntOBkQQ_269&quot;,null,13,null,null,null,null,null,5025273,&quot;horizon_jobs&quot;,[null,null,null,null,null,null,null,[[&quot;share_link&