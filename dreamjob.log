2z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-left-button>\u003C/div>\u003Cdiv jsname=\"AK6yne\" class=\"EQOGhe\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQyJoRegQIHRAs\">\u003Cg-right-button jsname=\"IHFM4\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"sYPGdb\" class=\"wgbRNb VdehBf tHT0l OZ5bRd btpNFe\" tabindex=\"-1\" aria-label=\"Siguiente\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"pW5NM4a40KcmcCkt53lrkQ\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_dveeaaRth9_WxA_gqJSBAg_156';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"ZwqdFuJgZak09drJAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador BackEnd / BackEnd Developer\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;dveeaaRth9_WxA_gqJSBAg55 xQKg9c;_;dveeaaRth9_WxA_gqJSBAg56\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Workforce, multinacional especialista en Servicios Transitorios y Outsourcing fundada en Sudáfrica en 1972, con más de 35.000 colaboradores a nivel global, se encuentra en búsqueda de un/a Desarrollador BackEnd / BackEnd Developer para integrarse a un proyecto tecnológico estratégico, enfocado en el desarrollo de plataformas internas y soluciones escalables para equipos de desarrollo.\u003Cbr>\u003Cbr>Si te apasi\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_dveeaaRth9_WxA_gqJSBAg_162\" aria-live=\"polite\" style=\"display:none\">ona desarrollar sistemas robustos, trabajar con microservicios y contribuir a la modernización de plataformas, esta oportunidad es para ti.\u003Cbr>\u003Cbr>Funciones principales\u003Cbr>\u003Cbr>Diseñar, desarrollar y mantener la plataforma interna que permite el autoservicio de recursos para desarrolladores.\u003Cbr>Abstraer y gestionar infraestructura compleja mediante herramientas de desarrollo internas.\u003Cbr>Participar en la creación y mantenimiento de microservicios, APIs REST y gRPC.\u003Cbr>Integrar sistemas de mensajería como RabbitMQ o Kafka.\u003Cbr>Colaborar con equipos de DevOps, Platform Engineering y FrontEnd para optimizar procesos.\u003Cbr>\u003Cbr>Requisitos\u003Cbr>\u003Cbr>Experiencia comprobable en al menos uno de los siguientes lenguajes: Java, Go, .NET Core o Python.\u003Cbr>Experiencia en arquitecturas de microservicios.\u003Cbr>Experiencia desarrollando APIs REST y/o gRPC.\u003Cbr>Conocimiento en sistemas de mensajería: RabbitMQ, Kafka u otros.\u003Cbr>Experiencia con Kubernetes y herramientas Cloud Native (deseable: Pulumi, Crossplane, Backstage).\u003Cbr>Experiencia trabajando con entornos productivos y escalables.\u003Cbr>\u003Cbr>Competencias\u003Cbr>\u003Cbr>Alta capacidad analítica y resolución de problemas.\u003Cbr>Habilidades de comunicación y trabajo colaborativo.\u003Cbr>Orientación a la calidad y escalabilidad de los sistemas.\u003Cbr>Capacidad para abstraer complejidad técnica y entregar soluciones eficientes.\u003Cbr>\u003Cbr>Ofrecemos\u003Cbr>\u003Cbr>Integración a proyecto tecnológico estratégico de alto impacto.\u003Cbr>Desarrollo profesional en entornos Cloud y modernas arquitecturas.\u003Cbr>Trabajo en equipo multidisciplinario.\u003Cbr>Renta acorde al mercado.\u003Cbr>\u003Cbr>Si cumples con el perfil y quieres formar parte de un equipo innovador en plataformas internas y microservicios, postula con Workforce.-Requerimientos- Educación mínima: Universitaria / I.P. / C.F.T.\u003Cbr>3 años de experiencia\u003Cbr>Palabras clave: programador\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_dveeaaRth9_WxA_gqJSBAg_162\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB0QLw\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQl5ACegQIHRAv\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv