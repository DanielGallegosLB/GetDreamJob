 seguridad y calidad de datos, además de liderazgo en metodologías y estándares QA.\",\"Tester (Junior a Senior)\",null,null,0,[[\"organization\",\"Empresa Confidencial\"],[\"publisher_name\",\"MiGuru\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0xc9315fc568ec02f4\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"h3Kfae6MB7DA5OUP5dDBkA453\":[null,null,null,null,null,null,null,null,[[15119900,0.0421001,4]]],\"h3Kfae6MB7DA5OUP5dDBkA474\":[\"https://miguru.ai/offers/qny9agtqcx-r77edveghz?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"MiGuru\",\"JCyG20NiOB1UDxaEAAAAAA\\u003d\\u003d\",0,1],\"h3Kfae6MB7DA5OUP5dDBkA498\":[null,null,\"bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Empresa Confidencial',job_title:'Tester (Junior a Senior)'})\",\"_h3Kfae6MB7DA5OUP5dDBkA4_165\",null,13,null,null,null,null,null,5025273,\"horizon_jobs\",[null,null,null,null,null,null,null,[[\"share_link\",\"https://www.google.com/search?q\\u003dTrabajo+testing+QA+tester+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19\"],[\"jobs_posting_urls_1\",\"https://miguru.ai/offers/qny9agtqcx-r77edveghz?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\"],[\"jobs_posting_domain_1\",\"\"],[\"jobs_posting_urls\",\"\\nhttps://miguru.ai/offers/qny9agtqcx-r77edveghz?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\"],[\"jobs_encoded_docids\",\"\\nJCyG20NiOB1UDxaEAAAAAA\\u003d\\u003d\"]]],null,null,null,null,null,30,null,null,null,1,null,1],\"h3Kfae6MB7DA5OUP5dDBkA416\":[null