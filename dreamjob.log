lector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_N83naZjbOsbc5OUPqtL4kAM_202';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"zxWgI3cHB1xDiaelAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Back-End\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;N83naZjbOsbc5OUPqtL4kAM53 xQKg9c;_;N83naZjbOsbc5OUPqtL4kAM59\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">• Misión\u003Cbr>\u003Cbr>Especialista en la arquitectura interna de las aplicaciones, garantizando la seguridad, el rendimiento y la integridad de los datos en el servidor para soportar la lógica de negocio.\u003Cbr>• Principales Objetivos\u003Cbr>• Crear lógica de negocio robusta y escalable. Asegurar que las aplicaciones respondan correctamente a las reglas del negocio.\u003Cbr>• Integrar bases de datos (SQL/NoSQL) optimizando consul\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_266\" aria-live=\"polite\" style=\"display:none\">tas. Garantizar la integridad y velocidad en el acceso a los datos.\u003Cbr>• Desarrollar microservicios con alta disponibilidad. Facilitar la escalabilidad y mantenibilidad del sistema.\u003Cbr>• Implementar medidas de seguridad a nivel de API y autenticación. Proteger la información sensible frente a accesos no autorizados.\u003Cbr>• Conocimientos y Uso de Sistemas\u003Cbr>\u003Cbr>- Lenguajes: Java (Spring Boot), .NET / C#, Python, Node.js.\u003Cbr>\u003Cbr>- Bases de Datos: Oracle, SQL Server, MySQL, DynamoDB.\u003Cbr>\u003Cbr>- Arquitectura: Microservicios, REST, SOAP, Mensajería (RabbitMQ/Kafka).\u003Cbr>• Educación\u003Cbr>\u003Cbr>Ingeniería en Software, Informática o carreras afines.\u003Cbr>• Experiencia\u003Cbr>\u003Cbr>Mínimo 3 años en desarrollo back-end con manejo de alta concurrencia.\u003Cbr>• Competencias\u003Cbr>\u003Cbr>Calidad, Compromiso, Transparencia, Adaptación a Entornos Digitales.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_266\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB0QVg\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQl5ACegQIHRBW\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQ5ZkFegQIHRBX\">\u003Cdiv class=\"EyBRub\" data-ve