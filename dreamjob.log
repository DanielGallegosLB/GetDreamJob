_1BmM\"],\"0x066d78b28c8b84e9\"]}],\"dveeaaRth9_WxA_gqJSBAg45\":[[\"https://www.google.com/search?ibp\\u003dhtl;jobs\\u0026q\\u003dDesarrollador+Junior+OR+Backend+Developer+Santiago,+Chile\\u0026htidocid\\u003d_TuzjdgdDuslB7TuAAAAAA%3D%3D\\u0026hl\\u003des-419\\u0026shndl\\u003d37\\u0026shmd\\u003dH4sIAAAAAAAA_xXMMQ6CQBAF0NjS2lltbcEaExusTEw4AAcgs_Bd0GVnZEZD761svZiheeUrPpvCX0RGyu6KNxIL5sqF31efL_TkejhMksAO2dXMMWF3HsxEK-9VUxnVyMau7HjynBF48XcOutLqQDMkkaE9ng5LKTnutw3fzPBYv4ayjRT5DxTkOJaGAAAA\\u0026shmds\\u003dv1_ATWGeeP7n1bPb2NrR-hxc6PY3HB7Gh5SawQ8mk0fYqirhRVArA\\u0026source\\u003dsh/x/job/li/m1/1#fpstate\\u003dtldetail\\u0026htivrt\\u003djobs\\u0026htiq\\u003dDesarrollador+Junior+OR+Backend+Developer+Santiago,+Chile\\u0026htidocid\\u003d_TuzjdgdDuslB7TuAAAAAA%3D%3D\",null,null,\"Appian Developer\",null,null,null,null,1,null,37,[\"H4sIAAAAAAAA_xXMMQ6CQBAF0NjS2lltbcEaExusTEw4AAcgs_Bd0GVnZEZD761svZiheeUrPpvCX0RGyu6KNxIL5sqF31efL_TkejhMksAO2dXMMWF3HsxEK-9VUxnVyMau7HjynBF48XcOutLqQDMkkaE9ng5LKTnutw3fzPBYv4ayjRT5DxTkOJaGAAAA\",\"v1_ATWGeeP7n1bPb2NrR-hxc6PY3HB7Gh5SawQ8mk0fYqirhRVArA\"]],[null,null,null,null,1]],\"dveeaaRth9_WxA_gqJSBAg61\":[[0,\"https://cl.linkedin.com/jobs/view/appian-developer-at-softtek-4377495870\",\"jobs\",\"6w4d2I2zO_1BmM\",\"\\u003cp\\u003e¿Te entusiasma crear productos que funcionen de punta a punta y que los usuarios disfruten de verdad? En este rol tendrás la oportunidad de trabajar tanto en el frontend como en el backend.\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🚀 ¿Qué buscamos en ti?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eBuscamos a alguien con ganas de construir, aprender y aportar. Nos gustaría que:\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eYa hayan trabajado desarrollando soluciones de punta a punta, moviéndose con soltura entre frontend y backend.\\u003c/li\\u003e\\u003cli\\u003eTengan experiencia o interés en tecnologías como \\u003cstrong\\u003eAngular, Spring Boot, Java 17, Appian\\u003c/strong\\u003e y herramientas de gestión como \\u003cstrong\\u003eJira\\u003c/strong\\u003e.\\u003c/li\\u003e\\u003cli\\u003eDisfruten crear \\u003cstrong\\u003eAPIs,\\u003c/strong\\u003e trabajar con bases de datos y construir lógica de negocio robusta.\\u003c/li\\u003e\\u003cli\\u003eValoren escribir software escalable, seguro y fácil de mantener.\\u003c/li\\u003e\\u003cli\\u003eSe sientan cómodas trabajando con \\u003cstrong\\u003emetodologías ágiles\\u003c/strong\\u003e y colaborando con distintos perfiles del equipo.\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003eNo buscamos perfección: buscamos ganas de construir, aprender y aportar\\u003cstrong\\u003e.\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🛠️ ¿Qué harás en tu día a día?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eParticiparás en iniciativas donde podrás diseñar y construir funcionalidades completas: desde la interfaz que ven los usuarios hasta la lógica y servicios que lo sostienen detrás.\\u003c/li\\u003e\\u003cli\\u003eEscribirás código limpio, eficiente y sostenible, ya sea para crear nuevas features, mejorar las existentes o resolver incidencias.\\u003c/li\\u003e\\u003cli\\u003eDesarrollarás nuevas características, mejorarás las existentes y atenderás incidencias, escribiendo código claro y sostenible. También trabajarás con plataformas como \\u003cstrong\\u003eAppian\\u003c/strong\\u003e cuando la solución lo requiera.\\u003c/li\\u003e\\u003cli\\u003eRevisarás y recibirás feedback de código, asegurando buenas prácticas, estándares internos y calidad en cada entrega.\\u003c/li\\u003e\\u003cli\\u003eTendrás la oportunidad de apoyar en el diseño de modelos de datos, diagramas de flujo y validaciones que garanticen integridad y buen desempeño de las soluciones.\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e🎁 Lo que la empresa te ofrece\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eAquí queremos que crezcas y estés bien, dentro y fuera del trabajo:\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eModalidad híbrida y work from home, \\u003c/strong\\u003epara que puedas equilibrar mejor tu tiempo y mantenerte conectado con tu equipo cuando más lo necesites.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eCobertura médica y dental sin costo, \\u003c/strong\\u003eporque tu salud importa dentro y fuera del trabajo.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eAtenciones médicas gratuitas por telemedicina, \\u003c/strong\\u003epara que recibas apoyo cuando lo necesites.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eSeguro de vida, \\u003c/strong\\u003ebrindando tranquilidad adicional para ti y tu familia.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eDías OFF y tarde libre en tu cumpleaños, \\u003c/strong\\u003epara que puedas disfrutar tiempo personal de verdad.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eBono de vacaciones y bono de conectividad, \\u003c/strong\\u003eacompañando tu descanso y tu trabajo desde casa.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFormación continua y capacitaciones internas\\u003c/strong\\u003e, para que sigas desarrollando tus habilidades técnicas y blandas.\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eConvenios corporativos, descuentos, gimnasio y snacks en oficina, \\u003c/strong\\u003eporque los pequeños detalles también hacen la diferencia.\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e\\u003cbr\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003e📩 ¿Te imaginas creciendo aquí?\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003eSi este rol conecta contigo y con lo que estás buscando en esta etapa, nos encantará conocerte.\\u003c/p\\u003e\\u003cp\\u003e Para construir un mejor futuro juntos, ¡postúlate!\\u003c/p\\u003e\\u003cp\\u003eEn Softtek, respetamos y reconocemos la diversidad del talento, promoviendo la equidad de trato y oportunidades. Conoce nuestra Política de Diversidad:\\u003c/p\\u003e\\u003cp\\u003e https://www.softtek.com/transcend\\u003c/p\\u003e\\u003cp\\u003e#codelikeyourself #BeWellDoGood #OrgulloSofttek #BeGreat #BeFutureFit #BeWellDoGood #CulturaÚnica #Softtekians\\u003c/p\\u003e\\u003cp\\u003e\\u003c/p\\u003e\",\"Appian Developer\",null,null,0,[[\"organization\",\"Softtek\"],[\"organization_mid\",\"/m/02q51xv\"],[\"publisher_name\",\"LinkedIn\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0x066d78b28c8b84e9\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"dveeaaRth9_WxA_gqJSBAg63\":[null,null,null,null,null,null,null,null,[[15113200,0.1350289,4]]],\"dveeaaRth9_WxA_gqJSBAg85\":[\"https://cl.linkedin.com/jobs/view/appian-developer-at-softtek-4377495870?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"LinkedIn\",\"_TuzjdgdDuslB7TuAAAAAA\\u003d\\u003d\",0,1],\"dveeaaRth9_WxA_gqJSBAg98\":[null,null,\"bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Softtek',job_title:'Appian Developer'})\",\"_dveeaaRth9_WxA_gqJSBAg_186\",null,13,null,null,null,null,null,5025273,\"horizon_jobs\",[null,null,null,null,null,null,null,[[\"share_link\",\"https://www.google.com/search?q\\u003dDesarrollador+Junior+OR+Backend+Developer+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19\"],[\"jobs_posting_urls_1\",\"https://cl.linkedin.com/jobs/view/appian-developer-at-softtek-4377495870?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorgani