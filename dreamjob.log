ps://cl.indeed.com/viewjob?jk\\u003d88eaa64dae0dac63\\u0026utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\\nhttps://cl.jooble.org/rjdp/4589165951252895345?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\"],[\"jobs_encoded_docids\",\"\\nkqIwlFely6pw8YezAAAAAA\\u003d\\u003d\\nvfHTl0AtWkQAAAAAAAAAAA\"]]],null,null,null,null,null,30,null,null,null,1,null,1],\"KA6eadnTDPbd1sQPmfyNiAY23\":[null,null,\"https://cl.talent.com/view?id\\u003d07eff313d3a0\",null,null,\"\",null,0,null,\"g_WtGYskMCeJnzc5AAAAAA\\u003d\\u003d\",0],\"KA6eadnTDPbd1sQPmfyNiAY43\":[null,null,\"Desarrollador Junior\",null,null,null,[\"https://encrypted-tbn0.gstatic.com/images?q\\u003dtbn:ANd9GcQxZcedD_3dF93ViStyNIWTQoxuaUqovO_AbE5a\\u0026s\\u003d0\",56,56],{\"16\":\"dt_fav_jobs\",\"17\":[20,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"0x24931b7751ceb594\"],\"42\":[\"SERQ\",null,\"Talent.com\",\"/google/oyster/feature/0x96626f6a7df81e51:0x60cdc26d444b83da\",[\"https://cl.talent.com/view?id\\u003d07eff313d3a0\",null,\"JzAkixmt9YPulM\"],\"0x24931b7751ceb594\"]}],\"KA6eadnTDPbd1sQPmfyNiAY46\":[[\"https://www.google.com/search?ibp\\u003dhtl;jobs\\u0026q\\u003dDesarrollador+Junior+Santiago,+Chile\\u0026htidocid\\u003dg_WtGYskMCeJnzc5AAAAAA%3D%3D\\u0026hl\\u003des-419\\u0026shem\\u003depsd1\\u0026shndl\\u003d37\\u0026shmd\\u003dH4sIAAAAAAAA_xXMsQrCMBAAUFz7CYKQ2aERxaWuiiA4WD-gXNojjVxzMXeF_obf4ubaH5Mub3zFZ1UcziiQMxNBx9ncxhg4V8bNP3mP2IHp0OCQCNlgNFdmT7g-9apJKmtFqPSioKEtWx4sR3Q82Rc7WWikh4yJQLHZH3dTmaLfbp6X-rFkNfowf6O5o2ZOTEEhwh_geRbKlAAAAA\\u0026shmds\\u003dv1_ATWGeePdOYu8NPVTf49eDXn0kMDyTrw-9GwBnPhxAJjLvranMg\\u0026source\\u003dsh/x/job/li/m1/1#fpstate\\u003dtldetail\\u0026htivrt\\u003djobs\\u0026htiq\\u003dDesarrollador+Junior+Santiago,+Chile\\u0026htidocid\\u003dg_WtGYskMCeJnzc5AAAAAA%3D%3D\",null,null,\"Desarrollador Junior\",null,null,null,null,1,null,37,[\"H4sIAAAAAAAA_xXMsQrCMBAAUFz7CYKQ2aERxaWuiiA4WD-gXNojjVxzMXeF_obf4ubaH5Mub3zFZ1UcziiQMxNBx9ncxhg4V8bNP3mP2IHp0OCQCNlgNFdmT7g-9apJKmtFqPSioKEtWx4sR3Q82Rc7WWikh4yJQLHZH3dTmaLfbp6X-rFkNfowf6O5o2ZOTEEhwh_geRbKlAAAAA\",\"v1_ATWGeePdOYu8NPVTf49eDXn0kMDyTrw-9GwBnPhxAJjLvranMg\"]],[null,null,null,null,1]],\"KA6eadnTDPbd1sQPmfyNiAY57\":[[0,\"https://cl.talent.com/view?id\\u003d07eff313d3a0\",\"jobs\",\"JzAkixmt9YPulM\",\"\\u003cp\\u003eSER Q SALUD es un sistema de información en Web, que contempla todas las aplicaciones necesarias para facilitar el proceso de preparación y mantención de la calidad de acreditados, a establecimientos de salud de atención abierta y cerrada. Es un software ágil, seguro y amigable para el usuario. Con muy poco tiempo, el profesional que interactúa con el sistema podrá corroborar que éste lo guía en forma segura y cómoda a donde quiera llegar.\\u003c/p\\u003e\\u003cp\\u003e\\u003cb\\u003eDesarrollador Junior\\u003c/b\\u003e\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003eResponsabilidad y autonomía : desarrollarte con apoyo y supervisión, potenciando tu crecimiento a través de la experiencia.\\u003c/li\\u003e\\u003cli\\u003eInvestigación y exploración tecnológica : buscar nuevas tecnologías, herramientas y frameworks para el negocio; participar activamente en la definición de soluciones.\\u003c/li\\u003e\\u003cli\\u003eDiseño y planificación : colaborar en el diseño de soluciones de baja a mediana complejidad, estimando tiempos y entregando una visión clara para los proyectos.\\u003c/li\\u003e\\u003cli\\u003eColaboración y levantamiento de requerimientos : participar en reuniones con áreas de negocio, levantando necesidades y colaborando en la administración de proyectos con enfoque técnico.\\u003c/li\\u003e\\u003cli\\u003eDesarrollo e implementación : crear código funcional para soluciones de mediana o baja complejidad, con supervisión y apoyo del equipo técnico.\\u003c/li\\u003e\\u003cli\\u003ePruebas y QA : generar pruebas unitarias y resolver errores / incidentes de menor complejidad.\\u003c/li\\u003e\\u003cli\\u003eEntrega y despliegue : implementar soluciones en ambientes pre-productivos, siguiendo lineamientos definidos por el equipo.\\u003c/li\\u003e\\u003cli\\u003eDocumentación y seguimiento : mantener registro claro y actualizado del progreso y actividades comprometidas.\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e\\u003cb\\u003eRequisitos excluyentes\\u003c/b\\u003e\\u003c/p\\u003e\\u003cli\\u003eConocimiento en .Net Framework, Entity Framework, MVC, Razor, JQuery, JavaScript.\\u003c/li\\u003e\\u003cli\\u003eDominio de SQL Server a nivel de desarrollo (consultas, procedimientos almacenados, modelado de datos)\\u003c/li\\u003e\\u003cli\\u003eManejo fluido de Visual Studio como entorno de desarrollo principal con C#\\u003c/li\\u003e\\u003cp\\u003e\\u003cb\\u003eRequisitos deseables\\u003c/b\\u003e\\u003c/p\\u003e\\u003cli\\u003eControl de versiones (Git / Bitbucket)\\u003c/li\\u003e\\u003cli\\u003eExperiencia en desarrollo de aplicaciones para el sector salud\\u003c/li\\u003e\\u003cp\\u003e«Todas estas experiencias no son excluyentes, pero altamente valoradas»\\u003c/p\\u003e\\u003cp\\u003e\\u003cb\\u003eBeneficios SER Q\\u003c/b\\u003e\\u003c/p\\u003e\\u003cli\\u003e38 horas semanales\\u003c/li\\u003e\\u003cli\\u003eLunes a Jueves 08 : 30 a 18 : 00, Viernes cortos (salimos a las 13 : 00 hrs)\\u003c/li\\u003e\\u003cli\\u003eFlexibilidad horaria\\u003c/li\\u003e\\u003cli\\u003eJornada laboral híbrida. Lunes y Viernes Teletrabajo\\u003c/li\\u003e\\u003cli\\u003ePolítica sin horas extras\\u003c/li\\u003e\\u003cli\\u003eCapacitaciones\\u003c/li\\u003e\\u003cli\\u003e5 días administrativos anuales y 12 permisos anuales de Teletrabajo.\\u003c/li\\u003e\\u003cli\\u003eTarde libre en tu cumpleaños\\u003c/li\\u003e\\u003cli\\u003eSi cumples 2 años con nosotros… ¡el notebook es tuyo!\\u003c/li\\u003e\\u003cp\\u003e#J-18808-Ljbffr\\u003c/p\\u003e\",\"Desarrollador Junior\",null,null,0,[[\"organization\",\"SERQ\"],[\"publisher_name\",\"Talent.com\"],[\"location_feature_id\",\"/google/oyster/feature/0x96626f6a7df81e51:0x60cdc26d444b83da\"],[\"cluster_id\",\"0x24931b7751ceb594\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"KA6eadnTDPbd1sQPmfyNiAY58\":[null,null,null,null,null,null,null,null,[[15113200,0.14145106,4]]],\"KA6eadnTDPbd1sQPmfyNiAY69\":[\"https://cl.talent.com/view?id\\u003d07eff313d3a0\\u0026utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"Talent.com\",\"g_WtGYskMCeJnzc5AAAAAA\\u003d\\u003d\",0,1],\"KA6eadnTDPbd1sQPmfyNiAY94\":[null,null,\"bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'SERQ',job_title:'Desarrollador Junior'})\",\"_KA6eadnTDPbd1sQPmfyNiAY_163\",null,13,null,null,null,null,null,5025273,\"horizon_jobs\",[null,null,null,null,null,null,null,[[\"share_link\",\"https://www.google.com/search?q\\u003dDesarrollador+Junior+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19\"],[\"jobs_posting_urls_1\",\"https://cl.talent.com/view?id\\u003d07eff313d3a0\\u0026utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\"],[\"jobs_posting_domain_1\",\"\"],[\"jobs_posting_urls\",\"\\nhttps://cl.talent.com/view?id\\u003d07eff313d3a0\\u0026utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\"],[\"jobs_encoded_docids\",\"\\ng_WtGYskMCeJnzc5AAAAAA\\u003d\\u003d\"]]],null,null,null,null,null,30,null,null,null,1,null,1],\"KA6eadnTDPbd1sQPmfyNiAY22\":[null,null,\"https://cl.jooble.org/jdp/5887752937491314984\",null,null,\"\",null,0,null,\"ZHdEftk79x7RhMu_AAAAAA\\u003d\\u003d\",0],\"KA6eadnTDPbd1sQPmfy