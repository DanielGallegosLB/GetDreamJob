\"sIJmDf\" class=\"pQXcHc wgbRNb bCwlI tHT0l OZ5bRd btpNFe\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"PfjCMb\" tabindex=\"-1\" aria-label=\"Anterior\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-left-button>\u003C/div>\u003Cdiv jsname=\"AK6yne\" class=\"EQOGhe\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyJoRegQIHxAy\">\u003Cg-right-button jsname=\"IHFM4\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"sYPGdb\" class=\"wgbRNb VdehBf tHT0l OZ5bRd btpNFe\" tabindex=\"-1\" aria-label=\"Siguiente\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"lAavCfiX0OcZaL1aqtFOVg\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_h3Kfae6MB7DA5OUP5dDBkA4_158';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"zS1_2g0knu-ST-WpAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"QA Tester\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;h3Kfae6MB7DA5OUP5dDBkA469 xQKg9c;_;h3Kfae6MB7DA5OUP5dDBkA470\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Wand makes gaming magical. Through game customization and guidance, we build tools that helps players have more fun in their favorite games.\u003Cbr>\u003Cbr>Our platform works across thousands of PC games, ensuring that great games are accessible to everyone, regardless of time constraints, skill level, or accessibility needs.\u003Cbr>We want to build the future of game assistance, and we're hoping you'll join us.\u003Cbr>\u003Cbr>Abou\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_203\" aria-live=\"polite\" style=\"display:none\">t Us\u003Cbr>\u003Cbr>At Wand, we're on a mission to make gaming more fun.\u003Cbr>\u003Cbr>We're building the world's ultimate game companion, where millions of PC gamers discover mind-blowing ways to play their favorite games.\u003Cbr>\u003Cbr>Founded with a community-first approach, Wand has become the go-to destination for gamers seeking safe and seamless ways to enhance their gaming experience.\u003Cbr>\u003Cbr>Our platform unites cutting-edge technology with unwavering security, transforming how players interact with games through innovative features like interactive maps and real-time mods.\u003Cbr>\u003Cbr>What drives us is our deep commitment to the gaming community and our belief that everyone deserves access to extraordinary gaming experiences.\u003Cbr>We are all gamers at heart, dedicated to building a platform that continually surprises and delights our users.\u003Cbr>\u003Cbr>Role Overview\u003Cbr>\u003Cbr>Do you love playing single-player video games and dream of making a living doing so?\u003Cbr>\u003Cbr>We're seeking passionate QA Testers to help ensure our community has access to reliable, high-quality gaming experiences. This role focuses on testing and validating mods to enhance gameplay while maintaining Wand's commitment to safety and quality.\u003Cbr>\u003Cbr>Key Responsibilities\u003Cbr>\u003Cbr>Test and validate game modifications across a wide range of PC titles\u003Cbr>Meet established performance metrics and testing KPIs\u003Cbr>Document and report findings with detailed attention to functionality and user experience\u003Cbr>Provide structured feedback to improve mod instructions and descriptions\u003Cbr>\u003Cbr>Who You Are\u003Cbr>\u003Cbr>A dedicated gamer with a deep understanding of video game mechanics\u003Cbr>Strong attention to detail and systematic approach to testing\u003Cbr>Excellent written and verbal communication skills in English\u003Cbr>Stable high-speed internet connection (100Mb/s minimum)\u003Cbr>PC capable of running modern games and recording gameplay footage\u003Cbr>Experience using Discord for team collaboration\u003Cbr>Self-motivated with strong time management skills\u003Cbr>\u003Cbr>Bonus Points\u003Cbr>\u003Cbr>Experience with Wand or similar modding platforms\u003Cbr>Background in software testing or quality assurance\u003Cbr>Knowledge of recording and streaming software\u003Cbr>\u003Cbr>What we offer\u003Cbr>\u003Cbr>The opportunity to play cutting-edge video games and explore immersive worlds as your job\u003Cbr>Competitive compensation\u003Cbr>A flexible work environment that caters to your gaming schedule\u003Cbr>A chance to be part of a passionate community of gamers and creators\u003Cbr>\u003Cbr>How To Apply\u003Cbr>\u003Cbr>Please submit your resume along with:\u003Cbr>\u003Cbr>Detailed PC specifications:\u003Cbr>Storage capacity\u003Cbr>\u003Cbr>RAM\u003Cbr>Processor\u003Cbr>Graphics card\u003Cbr>Internet speed\u003Cbr>\u003Cbr>Join us in creating the ultimate PC gaming companion\u003Cbr>\u003Cbr>Wand is an equal opportunity employer committed to building a diverse and inclusive team. We welcome applications from all qualified candidates regardless of background.\u003Cbr>\u003Cbr>Show more Show less\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_203\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB8QNQ\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQl5ACegQIHxA1\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQ5ZkFegQIHxA2\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyo8CegQIHxA3\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/go