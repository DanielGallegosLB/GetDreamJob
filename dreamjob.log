41L14 6l-6 6 6 6 1.41-1.41L10.83 12z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-left-button>\u003C/div>\u003Cdiv jsname=\"AK6yne\" class=\"EQOGhe\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQyJoRegQIIhAt\">\u003Cg-right-button jsname=\"IHFM4\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"sYPGdb\" class=\"wgbRNb VdehBf tHT0l OZ5bRd btpNFe\" tabindex=\"-1\" aria-label=\"Siguiente\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"pW5NM4a40KcmcCkt53lrkQ\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_dveeaaRth9_WxA_gqJSBAg_160';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"hBIWhejrEyNkuxXjAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Especialista Desarrollador - Microservicios\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;dveeaaRth9_WxA_gqJSBAg67 xQKg9c;_;dveeaaRth9_WxA_gqJSBAg68\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Les traemos una oportunidad desafiante para unirse a una compañía de servicios de TIC en crecimiento y con una cartera global, trabajando para un importante cliente del rubro bancario como Especialistas Desarrollador Microservicios\u003Cbr>\u003Cbr>Getronics es líder global en soluciones tecnológicas, con un equipo de más de 4.000 colegas en 22 países, ofreciendo servicios integrales de extremo a extremo en tod\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_dveeaaRth9_WxA_gqJSBAg_168\" aria-live=\"polite\" style=\"display:none\">o el mundo. Estamos comprometidos a brindar un servicio excepcional al cliente, permitiéndoles enfocarse en sus fortalezas principales mientras confían sus necesidades de TI a Getronics.\u003Cbr>\u003Cbr>Objetivo del rol:\u003Cbr>\u003Cbr>Evaluar, diseñar y proponer iniciativas relacionadas a procesos, sistemas y/o tecnologías, realizando el levantamiento y análisis funcional/técnico de los requerimientos, de acuerdo a las normas y procedimientos vigentes, con el objetivo de mantener la continuidad operacional de los servicios de TI de la Corporación y entregar un servicio de calidad a las áreas usuarias.\u003Cbr>\u003Cbr>Funciones:\u003Cbr>\u003Cbr>- Crear/Modificar piezas de software por cambios, modificar piezas de software para automatización en procesos.- Participar y realizar certificaciones de pruebas unitarias e integrales.- Validar piezas de software modificadas/creadas en los distintos ambientes banco.\u003Cbr>\u003Cbr>- Desarrollar soluciones de software que hagan uso eficiente de los recursos computacionales disponibles (memoria, disco, procesador) y cumpliendo con los requerimientos acordados y las funcionalidades requeridas por el Product Owner, con los estándares definido por el líder técnico y arquitectura digital\u003Cbr>\u003Cbr>- Programar código funcional, mantenible y con calidad para el incremento del producto hasta llegar al producto final (Backend y Frontend).\u003Cbr>\u003Cbr>- Realizar y mantener pruebas unitarias de calidad de los componentes de la solución de cada sprint.\u003Cbr>\u003Cbr>- Corregir defectos o problemas encontrados en las pruebas QA.- Responsable de desarrollar incrementos de producto con calidad, que potencialmente se pueda poner en producción al final de cada sprint.\u003Cbr>\u003Cbr>- Abogar por la propiedad colectiva de código del incremento del sprint.- Siempre estar en la búsqueda continua de nuevas soluciones o mejoras en los entregables.\u003Cbr>\u003Cbr>Requisitos:\u003Cbr>\u003Cbr>- Formación profesional nivel universitario (carreras de 4 a 5 años de estudio)\u003Cbr>\u003Cbr>• Nivel de experto con HTML (últimas versiones), CSS compatible con múltiples navegadores, JavaScript, AJAX y diseño adaptativo\u003Cbr>\u003Cbr>• Conocimiento de desarrollo móvil y webUso de frameworks JavaScript MVC (AngularJS, Backbone, etc.)\u003Cbr>\u003Cbr>• Conocimiento de APIs y su aplicación práctica\u003Cbr>\u003Cbr>• Conocimiento de programación orientada a objetos\u003Cbr>\u003Cbr>• Capacidad para preparar tests unitarios y de integración\u003Cbr>\u003Cbr>Requerimiento adicional:\u003Cbr>\u003Cbr>o node version 18 o 20, de express la version 4\u003Cbr>\u003Cbr>o axios para consumo de ms/api\u003Cbr>\u003Cbr>o helmet para headers de seguridad\u003Cbr>\u003Cbr>o mongoose para la conexion a mongodb/mongoose\u003Cbr>\u003Cbr>o mssql para la conexion a BD SQL\u003Cbr>\u003Cbr>o vscode para escribir el código\u003Cbr>\u003Cbr>o gitlab para control de fuentes\u003Cbr>\u003Cbr>Lo que te ofrecemos:\u003Cbr>\u003Cbr>- Contrato indefinido\u003Cbr>\u003Cbr>- Seguros complementarios de salud (colaborador y cargas)\u003Cbr>\u003Cbr>- Modalidad de trabajo remota\u003Cbr>\u003Cbr>- Bono teletrabajo\u003Cbr>\u003Cbr>- Aguinaldos\u003Cbr>\u003Cbr>- Ofrecemos un entrenamiento completo como parte de un sólido proceso de inducción, que incluye oportunidades de desarrollo continuo a través de nuestra plataforma de aprendizaje en línea NorthStar, LinkedIn Learning y Udemy, con más de 80.000 cursos disponibles.\u003Cbr>\u003Cbr>- GetVibes, nuestro programa de escucha activa, nos permite conectar y recibir comentarios de todos los colegas. Como empresa, trabajamos juntos para elaborar planes de acción para mejorar y seguir desarrollando a Getronics.\u003Cbr>\u003Cbr>¡Si crees que cumplís con los requisitos, no dudes en postularte!\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_dveeaaRth9_WxA_gqJSBAg_168\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCIQMA\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQl5ACegQIIhAw\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQ5ZkFegQIIhAx\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwikgNKb3vSSAxWHr5UCHWAUJSAQyo8CegQIIhAy\">\u003C