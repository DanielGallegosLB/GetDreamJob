ar is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"t2T8Twu21tEiIY-hAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Junior fullstack con experiencia en typescrip(remoto)\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;KA6eadnTDPbd1sQPmfyNiAY52 xQKg9c;_;KA6eadnTDPbd1sQPmfyNiAY54\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Tienes al menos 1 año de experiencia desarrollando soluciones web y quieres seguir creciendo en un entorno técnico exigente? Buscamos un/a Desarrollador/a Full Stack Junior o Semi-Senior con ganas de aprender, aportar y trabajar en proyectos reales con tecnologías modernas.\u003Cbr>\u003Cbr>️ Requisitos deseables:\u003Cbr>\u003Cbr>+1 año de experiencia en desarrollo frontend y/o backend.\u003Cbr>\u003Cbr>Conocimientos en NestJS, Laravel (PHP), \u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_157\" aria-live=\"polite\" style=\"display:none\">Next.js o Nuxt.js.\u003Cbr>\u003Cbr>Familiaridad con Docker y conceptos de dockerización.\u003Cbr>\u003Cbr>Experiencia básica en servidores Linux y despliegues en VMs.\u003Cbr>\u003Cbr>Manejo de bases de datos relacionales: MySQL y/o PostgreSQL.\u003Cbr>\u003Cbr>Creación y consumo de APIs RESTful, pruebas con Postman.\u003Cbr>\u003Cbr>Conocimientos en automatización con Bash scripts (nivel básico/intermedio).\u003Cbr>\u003Cbr>Experiencia realizando CRUDs y siguiendo buenas prácticas de desarrollo.\u003Cbr>\u003Cbr>Uso de Git y trabajo en equipos con repositorios en GitHub o Bitbucket.\u003Cbr>\u003Cbr>Conocimiento o participación en flujos de CI/CD y herramientas como Bitbucket Pipelines.\u003Cbr>\u003Cbr>Interés por aprender sobre microservicios, arquitectura escalable y SonarQube.\u003Cbr>\u003Cbr>Familiaridad con metodologías ágiles como Scrum o Kanban.\u003Cbr>\u003Cbr>Valoramos:\u003Cbr>\u003Cbr>Ganas de aprender y crecer técnicamente.\u003Cbr>\u003Cbr>Iniciativa y buena comunicación.\u003Cbr>\u003Cbr>Enfoque en la calidad del código y el trabajo en equipo.\u003Cbr>\u003Cbr>¿Estás listo para el siguiente paso en tu carrera? ¡Postula o comparte esta oportunidad con alguien que esté buscando crecer como desarrollador/a!\u003Cbr>\u003Cbr>Renta Entre 900.000 a 1.200.000 liquido según experiencia\u003Cbr>Interesados enviar currículum actualizado con pretensiones de renta.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_157\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB8QLw\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQl5ACegQIHxAv\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQ5ZkFegQIHxAw\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQyo8CegQIHxAx\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jsl