u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"lAavCfiX0OcZaL1aqtFOVg\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_h3Kfae6MB7DA5OUP5dDBkA4_151';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"JCyG20NiOB1UDxaEAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Tester (Junior a Senior)\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;h3Kfae6MB7DA5OUP5dDBkA451 xQKg9c;_;h3Kfae6MB7DA5OUP5dDBkA453\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Importante organización se encuentra en búsqueda de un/a\u003Cbr>Tester\u003Cbr>para integrarse a su equipo de tecnología y asegurar la calidad de soluciones digitales en distintas etapas del ciclo de desarrollo.\u003Cbr>Buscamos perfiles desde nivel\u003Cbr>Junior hasta Senior\u003Cbr>, con experiencia en pruebas manuales y/o automatizadas, comprometidos con la mejora continua y la excelencia técnica.\u003Cbr>Misión del cargo:\u003Cbr>Garantizar la ca\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_160\" aria-live=\"polite\" style=\"display:none\">lidad del software mediante la planificación, diseño y ejecución de pruebas, asegurando que los productos cumplan con los estándares funcionales, técnicos y de negocio definidos.\u003Cbr>\u003Cbr>Perfil deseado\u003Cbr>\u003Cbr>Formación en Ingeniería en Sistemas, Informática o carreras afines.\u003Cbr>Experiencia en aseguramiento de calidad de software, ejecución de pruebas funcionales y diseño de casos de prueba.\u003Cbr>Manejo de reporte y seguimiento de defectos, validación de correcciones y conocimiento del ciclo de vida del software (SDLC).\u003Cbr>Experiencia en pruebas de regresión, integración, APIs y performance, utilizando herramientas de testing y gestión de incidencias.\u003Cbr>Participación en definición de criterios de aceptación, documentación de resultados y colaboración con equipos de desarrollo y producto.\u003Cbr>Para niveles más avanzados: dominio de automatización de pruebas, testing continuo en CI/CD, pruebas de seguridad y calidad de datos, además de liderazgo en metodologías y estándares QA.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_160\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCIQLw\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQl5ACegQIIhAv\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;lin