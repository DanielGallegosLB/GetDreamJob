REST.\\nParticipar en el análisis técnico y diseño de soluciones.\\nGestionar y optimizar consultas en bases de datos relacionales.\\nRealizar mantenimiento correctivo y evolutivo de aplicaciones existentes.\\nEjecutar pruebas unitarias e integración para asegurar la calidad del software.\\nApoyar procesos de despliegue y monitoreo en ambientes Linux.\\nDocumentar desarrollos, incidencias y mejoras implementadas.-Requerimientos- Educación mínima: Universitaria / I.P. / C.F.T.\\u003cbr/\\u003e años de experiencia\\u003cbr/\\u003ePalabras clave: developer, programador, internet, web\",\"Desarrollador Backend / Web (Spring Boot)\",null,null,0,[[\"organization\",\"GRAN AMERICAS SANTIAGO CHILE S.A.\"],[\"publisher_name\",\"Computrabajo\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662ebc5065a3a25:0xb21d19646eab232c\"],[\"cluster_id\",\"0x358d3c980018e889\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"yg2eacLjIoLR1sQPwJaTwQc68\":[null,null,null,null,null,null,null,null,[[15113300,0.5509759,4]]],\"yg2eacLjIoLR1sQPwJaTwQc77\":[\"https://cl.computrabajo.com/ofertas-de-trabajo/oferta-de-trabajo-de-desarrollador-backend-web-spring-boot-en-santiago-pudahuel-DF5EAABFC38AA1E961373E686DCF3405?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"Computrabajo\",\"7AY0z8XCOrrs0knDAAAAAA\\u003d\\u003d\",0,1],\"yg2eacLjIoLR1sQPwJaTwQc109\":[null,null,\"bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'GRAN AMERICAS SANTIAGO CHILE S.A.',job_title:'Desarrollador Backend / Web (Spring Boot)'})\",\"_yg2eacLjIoLR1sQPwJaTwQc_166\",null,13,null,null,null,null,null,5025273,\"horizon_jobs\",[null,null,null,null,null,null,null,[[\"share_link\",\"htt