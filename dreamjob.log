sName=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_N83naZjbOsbc5OUPqtL4kAM_194';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"iBRp1vqPob_bJIRUAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Programador\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;N83naZjbOsbc5OUPqtL4kAM56 xQKg9c;_;N83naZjbOsbc5OUPqtL4kAM61\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">🧠 ¿Qué buscamos?\u003Cbr>\u003Cbr>Buscamos una persona obsesiva con la eficiencia, que disfrute automatizar procesos, integrar sistemas y construir soluciones reales usando inteligencia artificial.\u003Cbr>\u003Cbr>No nos importa tanto tu título. Nos importa que sepas hacer que las cosas funcionen.\u003Cbr>\u003Cbr>⚙️ ¿Qué harás?\u003Cbr>• Diseñar e implementar automatizaciones para procesos internos (operaciones, ventas, cobranza, contabilidad)\u003Cbr>• Int\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_253\" aria-live=\"polite\" style=\"display:none\">egrar herramientas y sistemas (CRM, APIs, WhatsApp, ERPs, etc.)\u003Cbr>• Desarrollar soluciones con IA (chatbots, asistentes, flujos automatizados, análisis de datos)\u003Cbr>• Mejorar continuamente los flujos operacionales de la empresa\u003Cbr>• Proponer e implementar mejoras tecnológicas con impacto real en productividad\u003Cbr>• Trabajar directamente con áreas de negocio para transformar procesos manuales en sistemas inteligentes\u003Cbr>\u003Cbr>🧩 Requisitos (formales o informales)\u003Cbr>• Conocimientos en programación (Python, JavaScript u otros)\u003Cbr>• Experiencia integrando APIs o automatizando procesos (Zapier, Make, n8n u otros)\u003Cbr>• Familiaridad con herramientas de IA (OpenAI, LLMs, automatización con IA, etc.)\u003Cbr>• Capacidad de resolver problemas de forma autónoma\u003Cbr>• Mentalidad práctica: menos teoría, más ejecución\u003Cbr>\u003Cbr>💡 Suma puntos si:\u003Cbr>• Has creado bots, automatizaciones o integraciones funcionales\u003Cbr>• Has trabajado con WhatsApp API, CRMs o sistemas contables\u003Cbr>• Tienes proyectos propios (aunque sean informales)\u003Cbr>• Te interesa optimizar procesos y eliminar ineficiencias\u003Cbr>\u003Cbr>🎯 Qué ofrecemos\u003Cbr>• Espacio para crear, proponer y ejecutar sin burocracia\u003Cbr>• Impacto directo en múltiples empresas del holding\u003Cbr>• Trabajo con tecnologías actuales (IA, automatización, integraciones)\u003Cbr>• Proyección de crecimiento en un entorno dinámico\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_N83naZjbOsbc5OUPqtL4kAM_253\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCAQVQ\" data-ved=\"2ahUKEwjY0oyZ1P-TAxVGLrkGHSopHjIQl5ACegQIIBBV\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/