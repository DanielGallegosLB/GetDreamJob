nd Developer\",null,null,null,[\"https://encrypted-tbn0.gstatic.com/images?q\\u003dtbn:ANd9GcSayAHm9hCGtS4GeQ-Cjc86bUDwR2bPs3z8O2fV\\u0026s\\u003d0\",56,56],{\"16\":\"dt_fav_jobs\",\"17\":[20,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"0x2e5931503a8305ad\"],\"42\":[\"Yol1\",null,\"LinkedIn\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\",[\"https://cl.linkedin.com/jobs/view/backend-developer-at-yol1-4363737722\",null,\"JLZWv0mSw_D5aM\"],\"0x2e5931503a8305ad\"]}],\"yg2eacLjIoLR1sQPwJaTwQc43\":[[\"https://www.google.com/search?ibp\\u003dhtl;jobs\\u0026q\\u003dBackend+Developer+Santiago,+Chile\\u0026htidocid\\u003d8MOSSb9WtiTvVFyzAAAAAA%3D%3D\\u0026hl\\u003des-419\\u0026shndl\\u003d37\\u0026shmd\\u003dH4sIAAAAAAAA_xXMoQ7CMBAG4GCn0KhqxDpIMMMREh4AhVqu7Z9u0PXK7iCzvBaWFyMzn_yqz6pqTuQfyMGc8Ubigqk17veV5wuBTIDBWBLYIJsLc0zYHHvVIq21IqmOoqSDrz2PljMcz_bOThY66WlCSaTo9odmrkuO2_WN027JrpR1oMh_Lw5LnIQAAAA\\u0026shmds\\u003dv1_ATWGeeOjQp5M-0cvVcmi0YVEN1xl54KUHuasrmTsK5JZj4NbNg\\u0026source\\u003dsh/x/job/li/m1/1#fpstate\\u003dtldetail\\u0026htivrt\\u003djobs\\u0026htiq\\u003dBackend+Developer+Santiago,+Chile\\u0026htidocid\\u003d8MOSSb9WtiTvVFyzAAAAAA%3D%3D\",null,null,\"Backend Developer\",null,null,null,null,1,null,37,[\"H4sIAAAAAAAA_xXMoQ7CMBAG4GCn0KhqxDpIMMMREh4AhVqu7Z9u0PXK7iCzvBaWFyMzn_yqz6pqTuQfyMGc8Ubigqk17veV5wuBTIDBWBLYIJsLc0zYHHvVIq21IqmOoqSDrz2PljMcz_bOThY66WlCSaTo9odmrkuO2_WN027JrpR1oMh_Lw5LnIQAAAA\",\"v1_ATWGeeOjQp5M-0cvVcmi0YVEN1xl54KUHuasrmTsK5JZj4NbNg\"]],[null,null,null,null,1]],\"yg2eacLjIoLR1sQPwJaTwQc53\":[[0,\"https://cl.linkedin.com/jobs/view/backend-developer-at-yol1-4363737722\",\"jobs\",\"JLZWv0mSw_D5aM\",\"Company Description: Yol1\\u003cbr\\u003e\\u003cbr\\u003eJob Description: ¡Nueva oportunidad para impulsar tecnología con impacto real!\\u003cbr\\u003e\\u003cbr\\u003eEn Yol1 estamos buscando a un/a Backend Developer apasionado/a por construir arquitectura robusta, optimizar sistemas y aplicar prácticas modernas de DevOps.\\u003cbr\\u003e\\u003cbr\\u003eSi te motiva trabajar en entornos ágiles y ser parte de la evolución de aplicaciones críticas, ¡este desafío es para ti!\\u003cbr\\u003e\\u003cbr\\u003e Te integrarás al equipo liderado por Felipe E. Vildoso Castillo, colaborando en proyectos estratégicos que impulsarán nuestro backend y mejorarán la experiencia de nuestros productos digitales.\\u003cbr\\u003e\\u003cbr\\u003e¿Qué harás?\\u003cbr\\u003e\\u003cbr\\u003e\\u003cul\\u003e\\u003cli\\u003e Mantener y evolucionar el backend de nuestra app móvil en Spring Boot.\\u003c/li\\u003e\\u003cli\\u003e Desarrollar nuevas funcionalidades y optimizar código para mayor rendimiento.\\u003c/li\\u003e\\u003cli\\u003e Gestionar bases de datos PostgreSQL y mejorar consultas.\\u003c/li\\u003e\\u003cli\\u003e Implementar prácticas DevOps y pipelines CI/CD con GitHub Actions.\\u003c/li\\u003e\\u003cli\\u003e Administrar infraestructura en la nube AWS.\\u003c/li\\u003e\\u003cli\\u003e Dockerizar aplicaciones y asegurar despliegues confiables.\\u003c/li\\u003e\\u003cli\\u003e Escribir tests automatizados y participar en code reviews para mantener altos estándares de calidad.\\u003cbr\\u003e\\u003cbr\\u003e\\u003c/li\\u003e\\u003c/ul\\u003e¿Qué buscamos?\\u003cbr\\u003e\\u003cbr\\u003e\\u003cul\\u003e\\u003cli\\u003e Al menos 3 años de experiencia en desarrollo backend con Java/Kotlin y Spring Boot.\\u003c/li\\u003e\\u003cli\\u003e Experiencia aplicando prácticas DevOps en entornos productivos.\\u003c/li\\u003e\\u003cli\\u003e Conocimientos de bases de datos relacionales, APIs RESTful y containerización (Docker).\\u003c/li\\u003e\\u003cli\\u003e Dominio sólido de Java 11+ y ecosistema Spring (MVC, Data, Security).\\u003c/li\\u003e\\u003cli\\u003e Deseable experiencia en AWS, pipelines CI/CD y arquitecturas de microservicios.\\u003cbr\\u003e\\u003cbr\\u003e\\u003c/li\\u003e\\u003c/ul\\u003e¿Qué Ofrecemos?\\u003cbr\\u003e\\u003cbr\\u003e\\u003cul\\u003e\\u003cli\\u003e Bono de cumpleaños, fiestas patrias y navidad.\\u003c/li\\u003e\\u003cli\\u003e Acceso a nuestro palco VIP en Movistar Arena como beneficio adicional de cumpleaños.\\u003c/li\\u003e\\u003cli\\u003e Seguro Complementario de Salud.\\u003c/li\\u003e\\u003cli\\u003e Convenio Colectivo FALP.\\u003c/li\\u003e\\u003cli\\u003e Ambiente de apoyo y crecimiento.\\u003cbr\\u003e\\u003cbr\\u003e\\u003c/li\\u003e\\u003c/ul\\u003eCompromiso con la Diversidad e Inclusión\\u003cbr\\u003e\\u003cbr\\u003eEn Yol1 promovemos un ambiente laboral diverso, equitativo e inclusivo. Valoramos las distintas perspectivas y experiencias, y creemos que estas enriquecen nuestro equipo. Todas las personas son bienvenidas a postular, sin distinción de género, orientación sexual, edad, nacionalidad, origen étnico, religión o discapacidad.\",\"Backend Developer\",null,null,0,[[\"organization\",\"Yol1\"],[\"publisher_name\",\"LinkedIn\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0x2e5931503a8305ad\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"yg2eacLjIoLR1sQPwJaTwQc57\":[null,null,null,null,null,null,null,null,[[15113300,0.20790607,4]]],\"yg2eacLjIoLR1sQPwJaTwQc70\":[\"https://cl.linkedin.com/jobs/view/backend-developer-at-yol1-4363737722?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"LinkedIn\",\"8MOSSb9WtiTvVFyzAAAAAA\\u003d\\u003d\",0,1],\"yg2eacLjIoLR1sQPwJaTwQc82\":[\"https://cl.jooble.org/jdp/1572310208463282162?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",\"jooble.org\",\"Jooble\",\"ZVUrOQRM0iQAAAAAAAAAAA\",0],\"yg2eacLjIoLR1sQPwJaTwQc87\":[\"https://cl.bebee.com/job/60e229a4be142dd74d0c9e8355ba7301?utm_c