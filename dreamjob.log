it](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"08BXbFsJAYeOzJ9QAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Desarrollador Fullstack Junior\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;KA6eadnTDPbd1sQPmfyNiAY66 xQKg9c;_;KA6eadnTDPbd1sQPmfyNiAY67\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">¡Únete a nuestro equipo!\u003Cbr>\u003Cbr>Estamos en busca de un Profesional junior con experiencia en desarrollo de software, implementación de microservicios y consumo/creación de APIs (REST).\u003Cbr>\u003Cbr>Requisitos:\u003Cbr>- Formación técnica en programación y/o estudios en Ingeniería en Informática.\u003Cbr>- Sólidos conocimientos y habilidades en desarrollo Frontend y Backend, manejo de bases de datos, y que haya trabajado en entorno\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_205\" aria-live=\"polite\" style=\"display:none\">s donde se utilicen arquitecturas basadas en servicios.\u003Cbr>- Experiencia Técnica +6 meses en desarrollo de software.\u003Cbr>-Manejo de Inglés Intermedio conversacional\u003Cbr>\u003Cbr>Habilidades requeridas:\u003Cbr>- Java (excluyente), Python, C#, HTML, JavaScript.\u003Cbr>- Bases de datos: MySQL, PostgreSQL, SQL Server.\u003Cbr>- Consumo y creación de APIs REST y microservicios\u003Cbr>- Manejo de JSON, control de endpoints, autenticación básica (token, API keys)\u003Cbr>- Uso de Postman o herramientas similares para pruebas.\u003Cbr>- Frameworks / Tecnologías: Spring Boot (deseable), .NET, ASP.NET.\u003Cbr>- Herramientas y entornos: Eclipse, Visual Studio, Git, Tomcat, Swagger/OpenAPI, Power BI.\u003Cbr>\u003Cbr>Condiciones:\u003Cbr>-Horario Administrativo\u003Cbr>-Modalidad de Trabajo: 80% remoto\u003Cbr>-Contrato Plazo Fijo 3 meses, posterior Indefinido\u003Cbr>\u003Cbr>Si piensas que puedes encajar en el perfil no dudes en postular, envíanos tu CV y pretensión de renta.\u003Cbr>\u003Cbr>¡Felices de conocerte!\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_KA6eadnTDPbd1sQPmfyNiAY_205\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CBsQNw\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQl5ACegQIGxA3\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQ5ZkFegQIGxA4\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwjZh5Tc__KSAxX2rpUCHRl-A2EQyo8CegQIGxA5\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Technology Solutions',job_title:'Desarrollador Fullstack Junior'})&quot;,&quot;_KA6eadnTDPbd1sQPmfyNiAY_217&quot;,null,13,null,null,null,null,null,5025273,&quot;horizon_jobs&quot;,[null,null,null,null,null,null,null,[[&quot;share_link&quot;,&quot;https://www.google.com/search?q\\u003dDesarrollador+Junior+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19&quot;],[&quot;jobs_posting_urls