 viewBox=\"0 0 24 24\">\u003Cpath d=\"M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-left-button>\u003C/div>\u003Cdiv jsname=\"AK6yne\" class=\"EQOGhe\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyJoRegQIIBAu\">\u003Cg-right-button jsname=\"IHFM4\" style=\"top:0px\" aria-hidden=\"true\" jsaction=\"sYPGdb\" class=\"wgbRNb VdehBf tHT0l OZ5bRd btpNFe\" tabindex=\"-1\" aria-label=\"Siguiente\" role=\"button\">\u003Cg-fab class=\"sr9hec OvQkSb s3IB3\" style=\"background-color:#303134;color:#9aa0a6\">\u003Cspan class=\"U8v51e S3PB2d z1asCe\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/g-fab>\u003C/g-right-button>\u003C/div>\u003Cscript nonce=\"lAavCfiX0OcZaL1aqtFOVg\">(function(){\n(this||self).Bqpk9e=function(f,d,n,e,k,p){var g=document.getElementById(f);if(g&&(g.offsetWidth!==0||g.offsetHeight!==0)){var l=g.querySelector(\"div\"),h=l.querySelector(\"div\"),a=0;f=Math.max(l.scrollWidth-l.offsetWidth,0);if(d>0&&(h=h.children,a=h[d].offsetLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_h3Kfae6MB7DA5OUP5dDBkA4_157';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"Ex_LIi0hfnWNFHjgAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Analista QA Automatizador Senior\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;h3Kfae6MB7DA5OUP5dDBkA466 xQKg9c;_;h3Kfae6MB7DA5OUP5dDBkA467\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Somos una empresa con 35 años en el mercado, contamos con servicios de fábrica de desarrollo de software y prestación de servicios de profesionales a través de Outsourcing, nuestra matriz está en Concepción y contamos con una operación en Santiago.\u003Cbr>\u003Cbr>Nos encontramos en búsqueda de un Analista QA Automatizador, con experiencia en aseguramiento de la calidad y automatización de pruebas, para integrar\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_163\" aria-live=\"polite\" style=\"display:none\">se a equipos ágiles en un proyecto de alto impacto tecnológico.\u003Cbr>\u003Cbr>Funciones del Cargo\u003Cbr>• Diseñar, desarrollar y mantener pruebas automatizadas (funcionales y no funcionales).\u003Cbr>• Elaborar, ejecutar y mantener planes y casos de prueba.\u003Cbr>• Definir y estructurar escenarios de prueba considerando impacto y continuidad operacional.\u003Cbr>• Ejecutar pruebas manuales y automatizadas, documentando y evidenciando resultados.\u003Cbr>• Reportar, gestionar y dar seguimiento a defectos e incidencias.\u003Cbr>• Proponer y ejecutar pruebas de regresión automatizadas.\u003Cbr>• Gestionar y preparar datos de prueba (acondicionamiento y uso de datos productivos controlados).\u003Cbr>• Participar activamente en equipos ágiles (Scrum / Kanban).\u003Cbr>• Revisar especificaciones funcionales y técnicas para anticipar riesgos de calidad.\u003Cbr>• Asesorar en el diseño de soluciones para mejorar la calidad del producto.\u003Cbr>• Proponer mejoras continuas en las estrategias y procesos de testing.\u003Cbr>• Ejecutar pruebas de performance y apoyar el levantamiento de métricas de calidad.\u003Cbr>\u003Cbr>Requisitos del Cargo\u003Cbr>• Mínimo 5 años en control de calidad y pruebas automatizadas\u003Cbr>• Sólida experiencia en automatización de pruebas\u003Cbr>• Experiencia en pruebas funcionales y no funcionales.\u003Cbr>• Experiencia comprobada en metodologías ágiles (Scrum, Kanban)\u003Cbr>• Conocimientos en herramientas de automatización y gestión de pruebas.\u003Cbr>• Capacidad de análisis, autonomía y orientación a la calidad.\u003Cbr>\u003Cbr>Requisitos Excluyentes\u003Cbr>Experiencia y conocimientos en:\u003Cbr>• Automatización de pruebas (Selenium, Junit, TestNG u otras)\u003Cbr>• Frameworks de CI/CD (Jenkins, GitLab CI)\u003Cbr>• API REST / SOAP\u003Cbr>• SoapUI / Postman.\u003Cbr>• Test Plan y gestión de casos de prueba.\u003Cbr>• Bases de datos: SQL Server, Oracle u otras.\u003Cbr>• SonarQube.\u003Cbr>• Conocimientos Técnicos: Dominio de lenguajes de programación como Java, Python o C#\u003Cbr>• JMeter (deseable para performance testing)\u003Cbr>• Deseable: Certificación ISTQB Certified Tester – Foundation Level\u003Cbr>\u003Cbr>Habilidades Blandas:\u003Cbr>• Capacidad de trabajo en equipo y buena comunicación.\u003Cbr>• Pensamiento analítico y atención al detalle.\u003Cbr>• Proactividad en la identificación y resolución de problemas\u003Cbr>\u003Cbr>Se Ofrece:\u003Cbr>Tipo Contrato: Proyecto- posibilidad de extensión, sujeta a desempeño y continuidad del proyecto\u003Cbr>Modalidad de trabajo: Híbrido, 3 a 4 días a la semana debe ir a la comuna de Pudahuel\u003Cbr>Horario: lunes a viernes 8:30 a 18:30 horas .\u003Cbr>\u003Cbr>-Requerimientos- Educación mínima: Universitaria / I.P. / C.F.T.\u003Cbr>5 años de experiencia\u003Cbr>Palabras clave: analyst, calidad, quality, qa, senior, sr\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_h3Kfae6MB7DA5OUP5dDBkA4_163\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCAQMQ\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQl5ACegQIIBAx\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQ5ZkFegQIIBAy\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwiu7LjK0_WSAxUwILkGHWVoEOIQyo8CegQIIBAz\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Genesys Ltda.',job_title:'Analista QA Automatizador Senior'})&quot;,&quot;_h3Kfae6MB7DA5OUP5dDBkA4_186&quot;,null,13,null,null,null,null,null,5025273,&quot;horizon_jobs&quot;,[null,null,null,null,null,null,null,[[&quot;share_link&quot;,&quot;https://www.google.com/search?q\\u003dTrabajo+testing+QA+tester+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19&quot;],[&quot;jobs_posting_urls_1&quot;,&quot;https://cl.computrabajo.com/ofertas-de-trabajo/oferta-de-trabajo-de-analista-qa-automatizador-senior-en-santiago-pudahuel-dc791812b6351ff361373e686dcf3405?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\