ruebas de carga.\\r\\n• Creación de escenarios y casos de prueba.\\r\\n\\r\\n\\r\\nSe ofrece:\\r\\nContrato Indefinido\\r\\nBeneficios adicionales\\r\\ntrabajo 100% Remoto y calidad de vida\\r\\nrenta entre 2.000.000 y 3.000.000 liquido segun experiencia \\r\\n\\r\\nInteresados enviar curriculum actualizado segun experiencia a consitor.reclutamiento@gmail.com\",\"QA Automatizador Senior experiencia Selenium (100% Remoto)\",null,null,0,[[\"organization\",\"Consistor Chile\"],[\"publisher_name\",\"Chiletrabajos\"],[\"location_feature_id\",\"/google/oyster/feature/0x9662c5410425af2f:0x8475d53c400f0931\"],[\"cluster_id\",\"0x24575c5a922977cb\"]],0],[null,1,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1],[null,0,null,[\"organization\",\"organization_mid\",\"publisher_name\",\"location_feature_id\",\"cluster_id\"],1,1,1]],\"h3Kfae6MB7DA5OUP5dDBkA456\":[null,null,null,null,null,null,null,null,[[15119900,0.2919692,4]]],\"h3Kfae6MB7DA5OUP5dDBkA476\":[\"https://www.chiletrabajos.cl/trabajo/qa-automatizador-senior-experiencia-selenium-100-remoto-3282645?utm_campaign\\u003dgoogle_jobs_apply\\u0026utm_source\\u003dgoogle_jobs_apply\\u0026utm_medium\\u003dorganic\",null,\"Chiletrabajos\",\"erRIfZIDINpcmyElAAAAAA\\u003d\\u003d\",0,1],\"h3Kfae6MB7DA5OUP5dDBkA497\":[null,null,\"bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Consistor Chile',job_title:'QA Automatizador Senior experiencia Selenium (100% Remoto)'})\",\"_h3Kfae6MB7DA5OUP5dDBkA4_167\",null,13,null,null,null,null,null,5025273,\"horizon_jobs\",[null,null,null,null,null,null,null,[[\"share_link\",\"https://www.google.com/search?q\\u003dTrabajo+testing+QA+tester+Santiago,+Chile\\u0026ibp\\u003dhtl;jobs\\u0026udm\\u003d19\"],[\"jobs_posting_urls_1\",\"https://www.chiletrabajos.cl/trabajo/qa-automatizador-senior-experiencia-selenium-100-remoto-3282645?utm_campaign\\u003dgoogle_jobs_app