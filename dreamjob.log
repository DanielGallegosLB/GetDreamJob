etLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_Xt3nabi2AfPS1sQPntOBkQQ_253';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"dV0C1Y0tkbyXLz3RAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Full Stack Developer\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;Xt3nabi2AfPS1sQPntOBkQQ88 xQKg9c;_;Xt3nabi2AfPS1sQPntOBkQQ89\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch2 class=\"HKvozf IFnjPb\">Descripción del trabajo\u003C/h2>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Reinventa con Accenture!\u003Cbr>\u003Cbr>Construye una carrera que te inspire y súmate a Accenture Technology para ser parte de la reinvención continua de la tecnología y las soluciones que transforman industrias y generan impacto positivo.\u003Cbr>\u003Cbr>En Accenture vivimos el futuro hoy. No solo aplicamos tecnología, la creamos. Trabajamos con las últimas innovaciones para resolver desafíos reales, combinando talento diver\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_Xt3nabi2AfPS1sQPntOBkQQ_272\" aria-live=\"polite\" style=\"display:none\">so, creatividad e ideas únicas. Creemos que cuando cada persona puede ser auténtica, el cambio sucede.\u003Cbr>\u003Cbr>Estamos en búsqueda de profesionales para el rol de Fullstack Developer que quieran crecer, aprender y dejar su huella siendo parte de un equipo inclusivo, colaborativo y global.\u003Cbr>\u003Cbr>Responsabilidades Principales:\u003Cbr>• Trabajar en la industria minera utilizando datos operacionales, contribuyendo a la toma de decisiones de negocio mediante soluciones de analítica avanzada.\u003Cbr>• Diseñar y desarrollar soluciones digitales end-to-end, con fuerte orientación a negocio y foco en generación de valor.\u003Cbr>• Participar en el diseño de soluciones utilizando tecnologías de Frontend como React, HTML/CSS y Dash/Plotly, y Backend como Flask y FastAPI, basadas en arquitectura Service Bus.\u003Cbr>• Desarrollar e implementar las soluciones diseñadas sobre plataforma cloud Azure, siguiendo estándares de calidad y escalabilidad.\u003Cbr>• Integrar, transformar y analizar información mediante el uso de SQL y Python (Pandas).\u003Cbr>• Aplicar buenas prácticas de desarrollo, incluyendo versionamiento de código con Git y despliegue en ambientes virtualizados.\u003Cbr>• Colaborar con equipos multidisciplinarios, participando activamente en instancias de mejora continua y evolución de las soluciones.\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_Xt3nabi2AfPS1sQPntOBkQQ_272\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CCMQVg\" data-ved=\"2ahUKEwi43a_M4_-TAxVzqZUCHZ5pIEIQl5ACegQIIxBW\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/20