tLeft-h[0].offsetLeft,e)){for(var m=a=0;m\u003Cd;++m)a+=h[m].offsetWidth;a=Math.min(f,a)}a+=n;d=Math.min(e?f-a:a,f);l.scrollLeft=e&&p?a:e&&k?-a:d;var b=g.getElementsByTagName(\"g-left-button\")[0],c=g.getElementsByTagName(\"g-right-button\")[0];b&&c&&(e=\nRegExp(\"\\\\btHT0l\\\\b\"),k=RegExp(\"\\\\bpQXcHc\\\\b\"),b.className=b.className.replace(e,\"\"),c.className=c.className.replace(e,\"\"),b.className=d===0?\"pQXcHc \"+b.className:b.className.replace(k,\"\"),c.className=d===f?\"pQXcHc \"+c.className:c.className.replace(k,\"\"),setTimeout(function(){b.className+=\" tHT0l\";c.className+=\" tHT0l\"},50))}};}).call(this);(function(){var id='_yg2eacLjIoLR1sQPwJaTwQc_158';var index=0;var offset=0;var is_rtl=false;var is_gecko=false;var is_edge=false;var init='Bqpk9e';window[init](id,index,offset,is_rtl,is_gecko,is_edge);})();\u003C/script>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"KLEmSd\">\u003C/div>\u003Cdiv data-encoded-docid=\"anQLyr9c1Rm7qUdVAAAAAA==\" data-implicit-notification-eligible=\"false\" data-result-index=\"0\" data-title=\"Backend Developer Santiago\" role=\"dialog\" jscontroller=\"leJiCf\" jsdata=\"ZSBYQe;_;yg2eacLjIoLR1sQPwJaTwQc64 xQKg9c;_;yg2eacLjIoLR1sQPwJaTwQc66\" jsaction=\"rcuQ6b:npT2md\">\u003Cdiv>\u003Cdiv class=\"XFOJCe\">\u003Ch3 class=\"HKvozf IFnjPb\">\u003Cspan>Descripción del trabajo\u003C/span>\u003C/h3>\u003Cspan jsname=\"QAWWu\" class=\"OOyDTc\">Sé el / la próxim@ Backend Developer de Global66 , acompáñanos a mejorar la calidad de vida de las personas y empresas a través de productos y servicios financieros tecnológicos.\u003Cbr>\u003Cbr>Somos una Tribu compuesta por más de 350 personas de diferentes nacionalidades, situadas en varios países (Chile, Argentina, Perú y Colombia) Nos conectamos a través de un servicio que no cree en las fronteras, tenemos c\u003C/span>\u003Cspan jsname=\"pqRzIf\">...\u003C/span>\u003Cspan jsname=\"ij8cu\" class=\"ejCXj\" id=\"tsuid_yg2eacLjIoLR1sQPwJaTwQc_164\" aria-live=\"polite\" style=\"display:none\">onciencia de grupo, nos apasiona lo que hacemos y celebramos cada logro como si ganara nuestro equipo favorito 💪.\u003Cbr>\u003Cbr>Nos hemos propuesto construir el próximo Neobanco Global de Latinoamérica y nada mejor que hacerlo con un gran equipo de trabajo, lleno de grandes talentos que se desafían todos los días para crear las mejores ideas, romper los límites de lo imposible y tomar riesgos que los lleven a lograr los resultados.\u003Cbr>\u003Cbr>Tus próximos desafíos 🚀\u003Cbr>\u003Cbr>El / la Backend Developer de Global66 , tendrá como objetivo la implementación tecnológica de productos financieros innovadores y de excelente calidad para nuestros clientes.\u003Cbr>\u003Cbr>Dentro de sus funciones están :\u003Cbr>• Desarrollo de Software : Java Springboot\u003Cbr>• Participar en instancias propias de proyectos de software : Daily meetings, planificaciones, etc.\u003Cbr>• Brindar soporte a software productivo.\u003Cbr>• Colaborar con las diferentes áreas de la empresa para escuchar necesidades de negocio y proponer soluciones técnicas para resolverlas.\u003Cbr>\u003Cbr>¿Qué buscamos?\u003Cbr>• Estudios en el área de desarrollo de Software\u003Cbr>• Al menos 4 años de experiencia desarrollando software usando Java y Springboot.\u003Cbr>• Estar familiarizado con entornos de desarrollo de software, por ejemplo conceptos como : Git, APIs REST, diferentes arquitecturas, contenedores, etc.\u003Cbr>\u003Cbr>Beneficios\u003Cbr>\u003Cbr>Somos un equipo de alto rendimiento, eso significa que estar aquí es ser de los mejores. Estamos orgullosos de representar a Global66 y de ser parte de esta tribu.\u003Cbr>\u003Cbr>¡Valoramos la diversidad y solo tenemos espacio para los que tienen hambre de crecimiento!\u003Cbr>\u003Cbr>Algunos beneficios más :\u003Cbr>• ¡Global66 te impulsa a la búsqueda de la excelencia y a sacar tu máximo potencial! Disfruta de cursos ilimitados a través de la plataforma de estudios de Udemy.\u003Cbr>• Solicitud de Stock Options de Global66\u003Cbr>• Cupón de descuento mensual en transferencias por nuestra app\u003Cbr>• Dress Code libre\u003Cbr>• Día libre de Cumpleaños\u003Cbr>• Global66 te regala el computador a los 2 años\u003Cbr>\u003Cbr>Y por si fuera poco… tendrás acceso a una App de beneficios de última generación,\u003Cbr>• Fitness Virtual\u003Cbr>• Telemedicina\u003Cbr>• Nutricionista\u003Cbr>• Soporte Psicológico\u003Cbr>• App de Meditación\u003Cbr>\u003Cbr>#J-18808-Ljbffr\u003C/span>\u003C/div>\u003Cdiv jsname=\"G7vtgf\" class=\"TOQyFc MmMIvd jRKCUd\" aria-controls=\"tsuid_yg2eacLjIoLR1sQPwJaTwQc_164\" role=\"button\" tabindex=\"0\" jsaction=\"EMtXr\" data-l=\"\" data-hveid=\"CB4QMQ\" data-ved=\"2ahUKEwjC8MCv__KSAxWCqJUCHUDLJHgQl5ACegQIHhAx\">\u003Chr class=\"Bi9oQd\" aria-hidden=\"true\">\u003Cdiv class=\"ZFiwCf\" style=\"background-color:var(--aYn2S)\">\u003Cspan class=\"LGwnxb JGD2rd\">\u003Cspan class=\"PBBEhf JGD2rd\">Mostrar descripción completa\u003C/span>\u003C/span>\u003Cspan class=\"w2fKdd z1asCe\" style=\"height:20px;line-height:20px;width:20px\">\u003Csvg focusable=\"false\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\u003Cpath d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\">\u003C/path>\u003C/svg>\u003C/span>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv class=\"XFOJCe\" data-ved=\"2ahUKEwjC8MCv__KSAxWCqJUCHUDLJHgQ5ZkFegQIHhAy\">\u003Cdiv class=\"EyBRub\" data-ved=\"2ahUKEwjC8MCv__KSAxWCqJUCHUDLJHgQyo8CegQIHhAz\">\u003Cdiv jscontroller=\"Wo3n8\" jsname=\"aadvhe\" jsmodel=\" d5EhJe\" data-bkt=\"horizon_jobs\" data-fhs=\"\" data-maindata=\"[null,null,&quot;bind('java/com/google/gws/plugins/horizon/jobs/viewer/herocontent/jslayout/feedback_messages.html#JobAtEmployer',{employer_name:'Global66',job_title:'Backend Developer Santiago'})&quot;,&quot;_yg2eacLjIoLR1sQPwJaTwQc_169&quot;,null,13,null,null,null,null,null,5025273,&quot;horizon_jobs&quot;,[null,null,null,null,null,null,null,[[&quot;share_link&quot;,&quot;https://www.goo